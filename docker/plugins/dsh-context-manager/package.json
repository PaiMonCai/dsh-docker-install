{
  "name": "dsh-docker-context-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH native context management policy editor and runtime compatibility probe (phase 2)",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
