cmd_start() {
  load_config; ensure_docker
  if container_running; then
    ok "$DSH_NAME 已在运行"
  elif container_exists; then
    docker_cmd start "$DSH_NAME" >/dev/null; ok "$DSH_NAME 已启动"
  else
    warn "容器不存在，将按当前配置创建。"
    pull_best_image; save_config; create_container
  fi
}
cmd_stop() {
  load_config; ensure_docker
  if container_running; then docker_cmd stop "$DSH_NAME" >/dev/null; ok "$DSH_NAME 已停止"; else info "$DSH_NAME 当前未运行"; fi
}
cmd_restart() {
  load_config; ensure_docker
  if container_exists; then
    docker_cmd restart "$DSH_NAME" >/dev/null || return 1
    if [[ "${DSHD_WEB_CONFIRMED:-0}" == 1 ]]; then
      wait_upgrade_healthy || { err "容器已重启，但未通过健康检查。"; return 1; }
    fi
    ok "$DSH_NAME 已重启"
  else
    cmd_start
  fi
}
cmd_logs() {
  load_config; ensure_docker
  container_exists || die "容器 $DSH_NAME 不存在。"
  docker_cmd logs -f --tail 200 "$DSH_NAME"
}
upgrade_rollback_name() {
  local previous="${DSH_NAME}-rollback"
  # Keep an existing rollback point intact until the next upgrade succeeds.
  if [[ "${DSHD_KEEP_ROLLBACK:-0}" == 0 ]] && docker_cmd inspect "$previous" >/dev/null 2>&1; then
    previous="${DSH_NAME}-rollback-pending"
  fi
  printf '%s\n' "$previous"
}

ensure_rollback_slot_free() {
  [[ "${DSHD_KEEP_ROLLBACK:-0}" =~ ^[01]$ ]] ||
    { err "DSHD_KEEP_ROLLBACK 必须为 0 或 1。"; return 1; }
  local previous
  previous="$(upgrade_rollback_name)"
  if container_exists && docker_cmd inspect "$previous" >/dev/null 2>&1; then
    err "回滚位置 $previous 尚未处理，请执行 dshd rollback status / clear。"
    return 1
  fi
  return 0
}

cleanup_upgrade_artifacts() {
  local mode="${1:-automatic}" previous running owner image current_image
  local result=0
  local -A images=()
  if [[ "$mode" == automatic ]]; then
    if ! container_running || [[ "$(health_state)" != healthy ]]; then
      warn "当前实例尚未健康，保留回滚容器和旧镜像，稍后可执行 dshd rollback clear。"
      return 1
    fi
  fi
  current_image="$(docker_cmd inspect -f '{{.Image}}' "$DSH_NAME" 2>/dev/null || true)"
  for previous in "${DSH_NAME}-rollback" "${DSH_NAME}-rollback-pending" "${DSH_NAME}-rollback-failed"; do
    docker_cmd inspect "$previous" >/dev/null 2>&1 || continue
    running="$(docker_cmd inspect -f '{{.State.Running}}' "$previous")" || { result=1; continue; }
    owner="$(docker_cmd inspect -f '{{index .Config.Labels "io.caicailo.dsh.instance"}}' "$previous")" ||
      { result=1; continue; }
    [[ "$owner" == "<no value>" ]] && owner=""
    if [[ "$running" != false || "$owner" != "${DSHD_INSTANCE_ID:-}" ]]; then
      warn "跳过 $previous：容器仍在运行或实例标签不匹配。"
      result=1
      continue
    fi
    image="$(docker_cmd inspect -f '{{.Image}}' "$previous")" || { result=1; continue; }
    # No force or volume removal: Docker must reject a concurrently started backup.
    if docker_cmd rm "$previous" >/dev/null; then
      ok "已清理回滚容器 $previous（保留数据卷）。"
      [[ -n "$image" && "$image" != "$current_image" ]] && images["$image"]=1
    else
      warn "无法清理 $previous，保留该容器及镜像。"
      result=1
    fi
  done
  for image in "${!images[@]}"; do
    # Removing by ID without force preserves images referenced by any container
    # or multiple tags. Never prune shared Standard layers or unrelated images.
    if docker_cmd image rm --no-prune "$image" >/dev/null 2>&1; then
      ok "已清理未使用的旧镜像 $image。"
    else
      warn "保留旧镜像 $image：可能仍被其他容器/多个标签引用，或删除失败。"
      result=1
    fi
  done
  return "$result"
}

finish_safe_upgrade() {
  if [[ "${DSHD_KEEP_ROLLBACK:-0}" == 1 ]]; then
    ok "旧版容器已保留，可用 dshd rollback 恢复应用版本。"
  elif ! cleanup_upgrade_artifacts automatic; then
    warn "更新已完成，部分旧资源保留，请查看上述清理提示。"
  fi
}

cmd_update() {
  load_config; ensure_docker
  ensure_rollback_slot_free || return 1
  heading "更新 dsh 镜像"
  pull_best_image || return 1
  web_prepare auto || warn "Web 管理后台未启用；可稍后执行 dshd web enable。"
  DSHD_SAFE_UPGRADE=1 create_container || return 1
  save_config || return 1
  finish_safe_upgrade
  ok "更新并重建完成。"
}
cmd_recreate() {
  load_config; ensure_docker
  ensure_rollback_slot_free || return 1
  pull_best_image || return 1
  DSHD_SAFE_UPGRADE=1 create_container || return 1
  save_config || return 1
  finish_safe_upgrade
}

cmd_rollback() {
  load_config; ensure_docker
  local action="${1:-apply}" previous="${DSH_NAME}-rollback" failed="${DSH_NAME}-rollback-failed"
  case "$action" in
    clear)
      confirm "清理当前实例停止的回滚容器及未使用旧镜像（保留数据卷），确认？" N || return 0
      cleanup_upgrade_artifacts manual
      ;;
    status)
      if docker_cmd inspect "$previous" >/dev/null 2>&1; then
        info "可回滚容器：$previous；原持久化数据始终共享，不会自动恢复历史数据库。"
      else
        info "没有可用的旧版回滚容器。"
      fi
      local extra
      for extra in "${DSH_NAME}-rollback-pending" "$failed"; do
        if docker_cmd inspect "$extra" >/dev/null 2>&1; then
          info "另有候选容器：$extra；检查后可执行 dshd rollback clear。"
        fi
      done
      ;;
    apply)
      docker_cmd inspect "$previous" >/dev/null 2>&1 ||
        { err "没有可用的回滚容器 $previous"; return 1; }
      docker_cmd inspect "$failed" >/dev/null 2>&1 &&
        { err "存在未清理的失败候选容器 $failed；请先手动检查。"; return 1; }
      if ! confirm "将容器切回旧版本。数据卷不会回滚；旧版程序可能不兼容新版已写入的数据结构。确认？" N; then
        return 0
      fi
      local old_image
      old_image="$(docker_cmd inspect -f '{{.Image}}' "$previous")" || return 1
      if container_exists; then
        docker_cmd stop "$DSH_NAME" >/dev/null || return 1
        if ! docker_cmd rename "$DSH_NAME" "$failed"; then
          docker_cmd start "$DSH_NAME" >/dev/null || true
          return 1
        fi
      fi
      if ! docker_cmd rename "$previous" "$DSH_NAME"; then
        docker_cmd rename "$failed" "$DSH_NAME" || true
        docker_cmd start "$DSH_NAME" >/dev/null || true
        return 1
      fi
      if ! docker_cmd start "$DSH_NAME" >/dev/null || ! wait_upgrade_healthy; then
        err "回滚版本未能健康启动；尝试恢复升级后容器，保留旧版候选。"
        docker_cmd stop "$DSH_NAME" >/dev/null || true
        if ! docker_cmd rename "$DSH_NAME" "$previous"; then
          err "旧版回滚容器无法恢复名称，请手动检查容器。"
          return 1
        fi
        if docker_cmd inspect "$failed" >/dev/null 2>&1; then
          docker_cmd rename "$failed" "$DSH_NAME" || return 1
          docker_cmd start "$DSH_NAME" >/dev/null || return 1
        fi
        return 1
      fi
      # Never accidentally recreate the *new* image after a successful
      # rollback; pin the running old Docker image ID in local config.
      DSH_IMAGE="$old_image"
      save_config
      ok "应用容器已回滚；配置已固定到旧镜像 ID。数据卷和工作区保持当前状态。"
      warn "升级后的容器保留在 $failed（已停止）。检查无误后可用 docker rm 删除；不要用 -v。"
      ;;
    *) err "用法：dshd rollback [status|apply|clear]"; return 2 ;;
  esac
}
cmd_config() {
  load_config
  ensure_docker
  interactive_config edit || {
    warn "配置未保存，原有配置保持不变。"
