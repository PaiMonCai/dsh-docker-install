#!/usr/bin/env bash
# dshd - DeepSeek Harness Docker 管理器
# 项目: https://github.com/PaiMonCai/dsh-docker-install
set -Eeuo pipefail

DSHD_VERSION="0.8.2"
REPO="PaiMonCai/dsh-docker-install"
RAW_BASE="https://raw.githubusercontent.com/${REPO}/main"
CDN_BASE="https://cdn.jsdelivr.net/gh/${REPO}@main"
# 自身脚本路径；通过管道（curl | bash）执行时为空，此时跳过自更新。
SELF_PATH="${BASH_SOURCE[0]:-}"
# 自更新拉取失败后的退避秒数，避免网络不通时每次启动都卡住。
SELF_UPDATE_RETRY_DELAY="${DSHD_SELF_UPDATE_RETRY_DELAY:-300}"
DEFAULT_IMAGE="ghcr.io/paimoncai/dsh-docker-install:latest"
MIRROR_IMAGE="ghcr.nju.edu.cn/paimoncai/dsh-docker-install:latest"
RESEARCH_IMAGE="ghcr.io/paimoncai/dsh-docker-install:research"
RESEARCH_MIRROR_IMAGE="ghcr.nju.edu.cn/paimoncai/dsh-docker-install:research"
RESEARCH_ECONOMICS_IMAGE="ghcr.io/paimoncai/dsh-docker-install:research-economics"
RESEARCH_ECONOMICS_MIRROR_IMAGE="ghcr.nju.edu.cn/paimoncai/dsh-docker-install:research-economics"
DEFAULT_NAME="dsh"
DEFAULT_PORT="3080"
DEFAULT_BIND_ADDR="127.0.0.1"
DEFAULT_RESEARCH_DASHBOARD_PORT="8765"
DEFAULT_VOLUME="dsh-home"
DEFAULT_STORAGE_MODE="bind"
DEFAULT_SHM_SIZE="1g"
DEFAULT_TIMEZONE="Asia/Shanghai"
DEFAULT_NPM_CACHE="/tmp/npm-cache"
DEFAULT_MEMORY_LIMIT=""
DEFAULT_MEMORY_SWAP=""

if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
  STATE_DIR="${DSHD_STATE_DIR:-/etc/dshd}"
  BASE_WORKSPACE="/opt/dsh/workspaces"
  DEFAULT_WORKSPACE="/opt/dsh/workspace"
  DEFAULT_DATA_DIR="/opt/dsh/data"
else
  STATE_DIR="${DSHD_STATE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dshd}"
  BASE_WORKSPACE="$HOME/dsh/workspaces"
  DEFAULT_WORKSPACE="$HOME/dsh/workspace"
  DEFAULT_DATA_DIR="$HOME/dsh/data"
fi
CONFIG_FILE="${DSHD_CONFIG_FILE:-$STATE_DIR/config.env}"
CONTAINER_ENV_FILE="${DSHD_CONTAINER_ENV_FILE:-$STATE_DIR/container.env}"
BACKUP_DIR="${DSHD_BACKUP_DIR:-$STATE_DIR/backups}"

C_RESET=$'\033[0m'
C_BLUE=$'\033[1;34m'
C_GREEN=$'\033[1;32m'
C_YELLOW=$'\033[1;33m'
C_RED=$'\033[1;31m'
C_CYAN=$'\033[1;36m'

info()    { printf '%s==>%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()      { printf '%s[✓]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn()    { printf '%s[!]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()     { printf '%s[x]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die()     { err "$*"; exit 1; }
heading() { printf '\n%s%s%s\n' "$C_CYAN" "$*" "$C_RESET"; }

is_tty() { [[ -t 0 && -t 1 ]]; }

confirm() {
  local prompt="${1:-确认继续？}" default="${2:-N}" ans
  if ! is_tty; then
    [[ "$default" =~ ^[Yy]$ ]]
    return
  fi
  if [[ "$default" =~ ^[Yy]$ ]]; then
    read -r -p "$prompt [Y/n] " ans || true
    [[ -z "$ans" || "$ans" =~ ^[Yy]$ ]]
  else
    read -r -p "$prompt [y/N] " ans || true
    [[ "$ans" =~ ^[Yy]$ ]]
  fi
}

prompt_value() {
  local __var="$1" prompt="$2" default="$3" value
  if is_tty; then
    read -r -p "$prompt [$default]: " value || true
  else
    value=""
  fi
  printf -v "$__var" '%s' "${value:-$default}"
}

prompt_required() {
  local __var="$1" prompt="$2" value="${!1:-}"
  if ! is_tty; then
    [[ -n "$value" ]] || die "$prompt：非交互安装必须通过环境变量提供。"
    return
  fi
  while [[ -z "$value" ]]; do
    read -r -p "$prompt: " value || true
    [[ -n "$value" ]] || warn "此项不能为空，请重新输入。"
  done
  printf -v "$__var" '%s' "$value"
}

validate_container_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

validate_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( 1 <= 10#$1 && 10#$1 <= 65535 ))
}

validate_docker_size() {
  [[ "$1" =~ ^[1-9][0-9]*([kKmMgG][bB]?)?$ ]]
}

docker_size_bytes() {
  local raw="${1,,}" number suffix factor=1
  [[ "$raw" =~ ^([1-9][0-9]*)([kmg]b?)?$ ]] || return 1
  number="${BASH_REMATCH[1]}"
  suffix="${BASH_REMATCH[2]:-}"
  case "$suffix" in
    k|kb) factor=1024 ;;
    m|mb) factor=$((1024 * 1024)) ;;
    g|gb) factor=$((1024 * 1024 * 1024)) ;;
  esac
  printf '%s' "$((number * factor))"
}

validate_timezone() {
  [[ "$1" =~ ^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$ ]]
}

port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"
  else
    return 1
  fi
}

as_root() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    die "此操作需要 root 权限；请使用 root 或安装 sudo。"
  fi
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR" "$BACKUP_DIR"
  chmod 700 "$STATE_DIR"
}

detect_docker_socket() {
  if [[ -S "${DSH_DOCKER_SOCKET:-}" ]]; then
    return 0
  fi
  if [[ -S /var/run/docker.sock ]]; then
    DSH_DOCKER_SOCKET=/var/run/docker.sock
  elif [[ -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/docker.sock" ]]; then
    DSH_DOCKER_SOCKET="${XDG_RUNTIME_DIR}/docker.sock"
  else
    DSH_DOCKER_SOCKET=/var/run/docker.sock
  fi
}

load_config() {
  local legacy_storage=false requested_volume="${DSH_VOLUME:-}" requested_data_dir="${DSH_DATA_DIR:-}"
  DSH_EDITION="${DSH_EDITION:-}"
  DSH_RESEARCH_PACK="${DSH_RESEARCH_PACK:-}"
  DSH_IMAGE="${DSH_IMAGE:-$DEFAULT_IMAGE}"
  DSH_NAME="${DSH_NAME:-$DEFAULT_NAME}"
  DSH_PORT="${DSH_PORT:-$DEFAULT_PORT}"
  DSH_BIND_ADDR="${DSH_BIND_ADDR:-$DEFAULT_BIND_ADDR}"
  DSH_RESEARCH_DASHBOARD_PORT="${DSH_RESEARCH_DASHBOARD_PORT:-$DEFAULT_RESEARCH_DASHBOARD_PORT}"
  DSH_WORKSPACE="${DSH_WORKSPACE:-$DEFAULT_WORKSPACE}"
  DSH_STORAGE_MODE="${DSH_STORAGE_MODE:-}"
  DSH_DATA_DIR="${DSH_DATA_DIR:-}"
  DSH_VOLUME="${DSH_VOLUME:-$DEFAULT_VOLUME}"
  DSH_SHM_SIZE="${DSH_SHM_SIZE:-$DEFAULT_SHM_SIZE}"
  DSH_TIMEZONE="${DSH_TIMEZONE:-$DEFAULT_TIMEZONE}"
  DSH_NPM_CACHE="${DSH_NPM_CACHE:-$DEFAULT_NPM_CACHE}"
  DSH_MEMORY_LIMIT="${DSH_MEMORY_LIMIT:-$DEFAULT_MEMORY_LIMIT}"
  DSH_MEMORY_SWAP="${DSH_MEMORY_SWAP:-$DEFAULT_MEMORY_SWAP}"
  DSH_TRUSTED_HOSTS="${DSH_TRUSTED_HOSTS:-}"
  DEEPSEEK_BASE_URL="${DEEPSEEK_BASE_URL:-}"
  DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-}"
  DSH_DOCKER_ACCESS="${DSH_DOCKER_ACCESS:-false}"
  DSH_DOCKER_SOCKET="${DSH_DOCKER_SOCKET:-}"

  if [[ -f "$CONFIG_FILE" ]]; then
    # config.env 仅由 dshd 自己写入，权限默认为 600。
    if ! grep -q '^DSH_STORAGE_MODE=' "$CONFIG_FILE" 2>/dev/null; then
      legacy_storage=true
    fi
    source "$CONFIG_FILE"
  fi

  # 兼容旧安装：历史 config.env 只有 DSH_VOLUME，没有存储模式。
  # 此时继续使用 named volume，不做静默迁移。
  if [[ -z "$DSH_STORAGE_MODE" ]]; then
    if [[ "$legacy_storage" == "true" || ( -n "$requested_volume" && -z "$requested_data_dir" ) ]]; then
      DSH_STORAGE_MODE="volume"
    else
      DSH_STORAGE_MODE="$DEFAULT_STORAGE_MODE"
    fi
  fi
  [[ -n "$DSH_DATA_DIR" ]] || DSH_DATA_DIR="$DEFAULT_DATA_DIR"
  case "$DSH_STORAGE_MODE" in
    bind)
      [[ "$DSH_DATA_DIR" == /* ]] || die "DSH_DATA_DIR 必须是绝对路径: $DSH_DATA_DIR"
      ;;
    volume)
      [[ -n "$DSH_VOLUME" ]] || die "DSH_VOLUME 不能为空。"
      ;;
    *)
      die "未知 DSH_STORAGE_MODE=$DSH_STORAGE_MODE（仅支持 bind/volume）。"
      ;;
  esac

  # 兼容旧配置：没有 DSH_EDITION / DSH_RESEARCH_PACK 时根据镜像推断。
  if [[ -z "$DSH_EDITION" ]]; then
    case "$DSH_IMAGE" in
      "$RESEARCH_IMAGE"|"$RESEARCH_MIRROR_IMAGE"|"$RESEARCH_ECONOMICS_IMAGE"|"$RESEARCH_ECONOMICS_MIRROR_IMAGE"|*:research|*:research-*) DSH_EDITION="research" ;;
      *) DSH_EDITION="standard" ;;
    esac
  fi
  if [[ -z "$DSH_RESEARCH_PACK" ]]; then
    case "$DSH_IMAGE" in
      "$RESEARCH_ECONOMICS_IMAGE"|"$RESEARCH_ECONOMICS_MIRROR_IMAGE"|*:research-economics|*:research-economics-*) DSH_RESEARCH_PACK="economics" ;;
      *) DSH_RESEARCH_PACK="none" ;;
    esac
  fi

  validate_port "$DSH_RESEARCH_DASHBOARD_PORT" \
    || die "无效 DSH_RESEARCH_DASHBOARD_PORT=$DSH_RESEARCH_DASHBOARD_PORT"
  [[ "$DSH_EDITION" == "standard" || "$DSH_EDITION" == "research" ]] \
    || die "未知 DSH_EDITION=$DSH_EDITION（仅支持 standard/research）。"
  [[ "$DSH_RESEARCH_PACK" == "none" || "$DSH_RESEARCH_PACK" == "economics" ]] \
    || die "未知 DSH_RESEARCH_PACK=$DSH_RESEARCH_PACK（仅支持 none/economics）。"
  if [[ "$DSH_EDITION" == "standard" ]]; then
    DSH_RESEARCH_PACK="none"
  fi

  detect_docker_socket
}

save_config() {
  ensure_state_dir
  local tmp
  tmp="$(mktemp)"
  {
    printf 'DSH_EDITION=%q\n' "$DSH_EDITION"
    printf 'DSH_RESEARCH_PACK=%q\n' "$DSH_RESEARCH_PACK"
    printf 'DSH_IMAGE=%q\n' "$DSH_IMAGE"
    printf 'DSH_NAME=%q\n' "$DSH_NAME"
    printf 'DSH_PORT=%q\n' "$DSH_PORT"
    printf 'DSH_BIND_ADDR=%q\n' "$DSH_BIND_ADDR"
    printf 'DSH_RESEARCH_DASHBOARD_PORT=%q\n' "$DSH_RESEARCH_DASHBOARD_PORT"
    printf 'DSH_WORKSPACE=%q\n' "$DSH_WORKSPACE"
    printf 'DSH_STORAGE_MODE=%q\n' "$DSH_STORAGE_MODE"
    printf 'DSH_DATA_DIR=%q\n' "$DSH_DATA_DIR"
    printf 'DSH_VOLUME=%q\n' "$DSH_VOLUME"
    printf 'DSH_SHM_SIZE=%q\n' "$DSH_SHM_SIZE"
    printf 'DSH_TIMEZONE=%q\n' "$DSH_TIMEZONE"
    printf 'DSH_NPM_CACHE=%q\n' "$DSH_NPM_CACHE"
    printf 'DSH_MEMORY_LIMIT=%q\n' "$DSH_MEMORY_LIMIT"
    printf 'DSH_MEMORY_SWAP=%q\n' "$DSH_MEMORY_SWAP"
    printf 'DSH_TRUSTED_HOSTS=%q\n' "$DSH_TRUSTED_HOSTS"
    printf 'DEEPSEEK_BASE_URL=%q\n' "$DEEPSEEK_BASE_URL"
    printf 'DEEPSEEK_API_KEY=%q\n' "$DEEPSEEK_API_KEY"
    printf 'DSH_DOCKER_ACCESS=%q\n' "$DSH_DOCKER_ACCESS"
    printf 'DSH_DOCKER_SOCKET=%q\n' "$DSH_DOCKER_SOCKET"
  } >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$CONFIG_FILE"
}

storage_source() {
  case "$DSH_STORAGE_MODE" in
    bind) printf '%s' "$DSH_DATA_DIR" ;;
    volume) printf '%s' "$DSH_VOLUME" ;;
    *) return 1 ;;
  esac
}

storage_label() {
  case "$DSH_STORAGE_MODE" in
    bind) printf 'bind:%s' "$DSH_DATA_DIR" ;;
    volume) printf 'volume:%s' "$DSH_VOLUME" ;;
    *) printf 'unknown' ;;
  esac
}

ensure_storage() {
  case "$DSH_STORAGE_MODE" in
    bind)
      if ! mkdir -p "$DSH_DATA_DIR" 2>/dev/null; then
        as_root mkdir -p "$DSH_DATA_DIR"
      fi
      ;;
    volume)
      docker_cmd volume inspect "$DSH_VOLUME" >/dev/null 2>&1 || docker_cmd volume create "$DSH_VOLUME" >/dev/null
      ;;
  esac
}

docker_cmd() {
  if docker info >/dev/null 2>&1; then
    docker "$@"
  elif command -v sudo >/dev/null 2>&1 && sudo docker info >/dev/null 2>&1; then
    sudo docker "$@"
  else
    return 125
  fi
}

docker_ready() {
  command -v docker >/dev/null 2>&1 && docker_cmd info >/dev/null 2>&1
}

detect_os() {
  OS_ID="unknown"
  OS_PRETTY="Unknown Linux"
  if [[ -r /etc/os-release ]]; then
    . /etc/os-release
    OS_ID="${ID:-unknown}"
    OS_PRETTY="${PRETTY_NAME:-${NAME:-$OS_ID}}"
  fi
}

install_curl_if_needed() {
  command -v curl >/dev/null 2>&1 && return 0
  info "未找到 curl，尝试安装..."
  if command -v apt-get >/dev/null 2>&1; then
    as_root apt-get update
    as_root apt-get install -y curl ca-certificates
  elif command -v dnf >/dev/null 2>&1; then
    as_root dnf install -y curl ca-certificates
  elif command -v yum >/dev/null 2>&1; then
    as_root yum install -y curl ca-certificates
  elif command -v apk >/dev/null 2>&1; then
    as_root apk add --no-cache curl ca-certificates
  else
    die "无法自动安装 curl，请手动安装后重试。"
  fi
}

install_docker() {
  detect_os
  heading "安装 Docker"
  info "系统: $OS_PRETTY"

  local installed=0
  if command -v apt-get >/dev/null 2>&1; then
    info "优先使用系统软件源安装 docker.io..."
    if as_root apt-get update && as_root apt-get install -y docker.io; then
      installed=1
      as_root apt-get install -y docker-compose-plugin >/dev/null 2>&1 || true
    fi
  elif command -v apk >/dev/null 2>&1; then
    if as_root apk add --no-cache docker docker-cli-compose; then installed=1; fi
  elif command -v dnf >/dev/null 2>&1; then
    if as_root dnf install -y docker; then installed=1; fi
  elif command -v yum >/dev/null 2>&1; then
    if as_root yum install -y docker; then installed=1; fi
  fi

  if [[ "$installed" -ne 1 ]]; then
    warn "系统软件源安装未成功，尝试 Docker 官方 convenience script。"
    install_curl_if_needed
    local tmp
    tmp="$(mktemp)"
    if ! curl -fsSL --connect-timeout 8 --max-time 30 https://get.docker.com -o "$tmp"; then
      rm -f "$tmp"
      die "无法下载安装 Docker。请先手动安装 Docker，再运行 dshd。"
    fi
    as_root sh "$tmp"
    rm -f "$tmp"
  fi

  if command -v systemctl >/dev/null 2>&1; then
    as_root systemctl enable --now docker >/dev/null 2>&1 || true
  elif command -v service >/dev/null 2>&1; then
    as_root service docker start >/dev/null 2>&1 || true
  fi

  command -v docker >/dev/null 2>&1 || die "Docker 安装后仍未找到 docker 命令。"
  if ! docker_ready; then
    warn "Docker 已安装，但当前用户还不能直接访问 daemon。"
    if [[ ${EUID:-$(id -u)} -ne 0 ]] && getent group docker >/dev/null 2>&1; then
      warn "可执行: sudo usermod -aG docker $USER，然后重新登录。当前 dshd 会尝试通过 sudo 使用 Docker。"
    fi
    docker_cmd info >/dev/null 2>&1 || die "Docker daemon 未运行或无法访问。"
  fi
  ok "Docker 可用: $(docker_cmd version --format '{{.Server.Version}}' 2>/dev/null || echo unknown)"
}

ensure_docker() {
  if docker_ready; then
    ok "Docker 已安装且 daemon 可用"
    return 0
  fi

  if command -v docker >/dev/null 2>&1; then
    warn "检测到 docker 命令，但 daemon 未运行或当前用户无权限。"
    if command -v systemctl >/dev/null 2>&1 && confirm "尝试启动 Docker 服务？" Y; then
      as_root systemctl start docker || true
    fi
    docker_ready && { ok "Docker 已可用"; return 0; }
  else
    warn "未检测到 Docker。"
  fi

  confirm "是否自动安装 Docker？" Y || die "需要 Docker 才能部署 dsh。"
  install_docker
}

probe_url() {
  local url="$1" code
  command -v curl >/dev/null 2>&1 || return 1
  code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 4 --max-time 8 "$url" 2>/dev/null || true)"
  [[ "$code" != "000" && -n "$code" ]]
}

network_report() {
  install_curl_if_needed
  heading "网络环境检测"

  if probe_url "https://raw.githubusercontent.com/"; then
    NET_RAW_GITHUB=1; ok "GitHub Raw 可达"
  else
    NET_RAW_GITHUB=0; warn "GitHub Raw 不可达或响应超时"
  fi

  if probe_url "https://ghcr.io/v2/"; then
    NET_GHCR=1; ok "GHCR 可达"
  else
    NET_GHCR=0; warn "GHCR 不可达或响应超时"
  fi

  if probe_url "https://registry-1.docker.io/v2/"; then
    NET_DOCKERHUB=1; ok "Docker Hub Registry 可达"
  else
    NET_DOCKERHUB=0; warn "Docker Hub Registry 不可达或响应超时"
  fi

  if probe_url "https://www.google.com"; then
    NET_REGION="global"; info "网络特征: 国际网络连通"
  elif probe_url "https://www.baidu.com"; then
    NET_REGION="cn"; info "网络特征: 可能为中国大陆网络"
  else
    NET_REGION="unknown"; info "网络特征: 无法可靠判断区域"
  fi
}

image_contract_ok() {
  local img="$1" probe

  if [[ "$DSH_EDITION" != "research" ]]; then
    return 0
  fi

  probe='command -v research-init >/dev/null && command -v research-run >/dev/null && command -v quarto >/dev/null'
  if [[ "$DSH_RESEARCH_PACK" == "economics" ]]; then
    probe="$probe && test \"\${DSH_RESEARCH_PACK:-}\" = economics && command -v research-econ-data >/dev/null && command -v research-econ-model >/dev/null && command -v research-econ-did >/dev/null"
  fi

  docker_cmd run --rm --entrypoint sh "$img" -c "$probe" >/dev/null 2>&1
}

pull_best_image() {  local candidates=() img
  local official="" mirror=""

  if [[ "$DSH_EDITION" == "research" ]]; then
    case "$DSH_RESEARCH_PACK" in
      economics)
        official="$RESEARCH_ECONOMICS_IMAGE"
        mirror="$RESEARCH_ECONOMICS_MIRROR_IMAGE"
        ;;
      none)
        official="$RESEARCH_IMAGE"
        mirror="$RESEARCH_MIRROR_IMAGE"
        ;;
      *)
        die "未知 Research Pack: $DSH_RESEARCH_PACK"
        ;;
    esac

    # Research 版只在同一 Pack 的官方/镜像 tag 之间回退，不静默换 Pack。
    # 自定义镜像保持第一优先级。
    if [[ -n "${DSH_IMAGE:-}" \
      && "$DSH_IMAGE" != "$RESEARCH_IMAGE" \
      && "$DSH_IMAGE" != "$RESEARCH_MIRROR_IMAGE" \
      && "$DSH_IMAGE" != "$RESEARCH_ECONOMICS_IMAGE" \
      && "$DSH_IMAGE" != "$RESEARCH_ECONOMICS_MIRROR_IMAGE" ]]; then
      candidates+=("$DSH_IMAGE")
    fi
    candidates+=("$official" "$mirror")
  else
    if [[ -n "${DSH_IMAGE:-}" && "$DSH_IMAGE" != "$DEFAULT_IMAGE" && "$DSH_IMAGE" != "$MIRROR_IMAGE" ]]; then
      candidates+=("$DSH_IMAGE")
    fi
    candidates+=("$DEFAULT_IMAGE" "$MIRROR_IMAGE")
  fi

  heading "拉取 dsh 镜像（edition=$DSH_EDITION, research-pack=$DSH_RESEARCH_PACK）"
  for img in "${candidates[@]}"; do
    info "尝试: $img"
    if docker_cmd pull "$img"; then
      if image_contract_ok "$img"; then
        DSH_IMAGE="$img"
        ok "镜像可用: $DSH_IMAGE"
        return 0
      fi
      warn "镜像已拉取，但不满足当前 edition / Research Pack 的运行契约: $img"
      continue
    fi
    warn "拉取失败: $img"
  done

  if is_tty; then
    local custom
    read -r -p "请输入自定义镜像地址（留空退出）: " custom || true
    if [[ -n "$custom" ]] && docker_cmd pull "$custom"; then
      if image_contract_ok "$custom"; then
        DSH_IMAGE="$custom"
        ok "镜像可用: $DSH_IMAGE"
        return 0
      fi
      warn "自定义镜像不满足当前 edition / Research Pack 的运行契约: $custom"
    fi
  fi

  die "当前 edition / Research Pack 的候选镜像均拉取失败。请检查网络、GHCR Package 可见性或自定义 DSH_IMAGE。"
}

container_exists() {
  docker_cmd ps -a --format '{{.Names}}' | grep -Fxq "$DSH_NAME"
}
container_running() {
  docker_cmd ps --format '{{.Names}}' | grep -Fxq "$DSH_NAME"
}
container_state() {
  if ! container_exists; then printf 'not-created'; return; fi
  docker_cmd inspect -f '{{.State.Status}}' "$DSH_NAME" 2>/dev/null || printf 'unknown'
}
health_state() {
  if ! container_exists; then printf 'n/a'; return; fi
  docker_cmd inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$DSH_NAME" 2>/dev/null || printf 'unknown'
}

create_container() {
  if ! mkdir -p "$DSH_WORKSPACE" 2>/dev/null; then
    as_root mkdir -p "$DSH_WORKSPACE"
  fi
  ensure_storage

  local data_source
  data_source="$(storage_source)"

  if container_exists; then
    info "移除旧容器 $DSH_NAME（持久化数据保留: $(storage_label)）..."
    docker_cmd rm -f "$DSH_NAME" >/dev/null
  fi

  local args=(
    run -d
    --name "$DSH_NAME"
    --restart unless-stopped
    --shm-size "$DSH_SHM_SIZE"
    -p "${DSH_BIND_ADDR}:${DSH_PORT}:3080"
    -e "DSH_TRUSTED_HOSTS=${DSH_TRUSTED_HOSTS}"
    -e "TZ=${DSH_TIMEZONE}"
    -e "NPM_CONFIG_CACHE=${DSH_NPM_CACHE}"
    -v "${data_source}:/root/.dsh"
    -v "${DSH_WORKSPACE}:/workspace"
    -w "/workspace"
  )

  [[ -n "$DEEPSEEK_API_KEY" ]] && args+=(-e "DEEPSEEK_API_KEY=$DEEPSEEK_API_KEY")
  [[ -n "$DEEPSEEK_BASE_URL" ]] && args+=(-e "DEEPSEEK_BASE_URL=$DEEPSEEK_BASE_URL")

  [[ -n "$DSH_MEMORY_LIMIT" ]] && args+=(--memory "$DSH_MEMORY_LIMIT")
  if [[ -n "$DSH_MEMORY_SWAP" ]]; then
    if [[ -z "$DSH_MEMORY_LIMIT" ]]; then
      warn "已配置 DSH_MEMORY_SWAP=$DSH_MEMORY_SWAP，但未配置 DSH_MEMORY_LIMIT；忽略 memory-swap。"
    else
      args+=(--memory-swap "$DSH_MEMORY_SWAP")
    fi
  fi

  if [[ "$DSH_DOCKER_ACCESS" == "true" ]]; then
    # 同一目录额外挂到容器内相同绝对路径，并切换 cwd。
    # 这样 docker compose 的相对 bind mount 交给宿主机 daemon 时路径仍然存在。
    args+=(
      -v "${DSH_WORKSPACE}:${DSH_WORKSPACE}"
      -w "$DSH_WORKSPACE"
    )
    detect_docker_socket
    [[ -S "$DSH_DOCKER_SOCKET" ]] || die "已开启 Docker 管理，但找不到 Docker socket: $DSH_DOCKER_SOCKET"
    args+=(
      -v "${DSH_DOCKER_SOCKET}:/var/run/docker.sock"
      --add-host "host.docker.internal:host-gateway"
      -e "DOCKER_HOST=unix:///var/run/docker.sock"
    )
  fi

  if [[ -s "$CONTAINER_ENV_FILE" ]]; then
    args+=(--env-file "$CONTAINER_ENV_FILE")
  fi

  info "启动容器 $DSH_NAME ..."
  docker_cmd "${args[@]}" "$DSH_IMAGE" >/dev/null
  wait_ready
}

first_trusted_host() {
  local raw="${DSH_TRUSTED_HOSTS:-}" host=""
  [[ -n "$raw" ]] || return 1
  IFS=', ' read -r host _ <<<"$raw" || true
  [[ -n "$host" ]] || return 1
  printf '%s' "$host"
}

token_suffix() {
  local url="$1"
  [[ "$url" == *"?"* ]] || return 1
  printf '?%s' "${url#*\?}"
}

local_token_url() {
  local source_url="$1" host suffix
  suffix="$(token_suffix "$source_url")" || return 1
  host="$DSH_BIND_ADDR"
  [[ "$host" == "0.0.0.0" || "$host" == "::" ]] && host="127.0.0.1"
  printf 'http://%s:%s/%s' "$host" "$DSH_PORT" "$suffix"
}

public_token_url() {
  local source_url="$1" trusted scheme="https" authority suffix
  trusted="$(first_trusted_host)" || return 1
  suffix="$(token_suffix "$source_url")" || return 1

  case "$trusted" in
    http://*) scheme="http"; authority="${trusted#http://}" ;;
    https://*) scheme="https"; authority="${trusted#https://}" ;;
    *) authority="$trusted" ;;
  esac
  authority="${authority%%/*}"
  [[ -n "$authority" ]] || return 1

  printf '%s://%s/%s' "$scheme" "$authority" "$suffix"
}

wait_ready() {
  local i url="" public_url="" local_url=""
  info "等待 Web UI 就绪..."
  for i in $(seq 1 60); do
    if ! container_running; then
      err "容器已退出。最近日志："
      docker_cmd logs --tail 50 "$DSH_NAME" 2>&1 || true
      return 1
    fi
    url="$(docker_cmd logs "$DSH_NAME" 2>&1 | grep -oE 'http://[^ ]*\?token=[A-Za-z0-9_-]+' | tail -1 || true)"
    [[ -n "$url" ]] && break
    sleep 1
  done

  if [[ -z "$url" ]]; then
    warn "容器仍在运行，但 60 秒内没有从日志读取到 token URL。"
    return 0
  fi

  local_url="$(local_token_url "$url")"
  public_url="$(public_token_url "$url" 2>/dev/null || true)"

  ok "Web UI 已就绪"
  if [[ -n "$public_url" ]]; then
    printf '\n域名访问地址（需反代 / HTTPS 已配置）：\n  %s\n' "$public_url"
    printf '\n本地回退地址：\n  %s\n\n' "$local_url"
  else
    printf '\n首次访问地址：\n  %s\n\n' "$local_url"
  fi
}

validate_base_url() {
  [[ "$1" =~ ^https?://[^[:space:]]+$ ]]
}

api_mode_label() {
  if [[ -n "${DEEPSEEK_BASE_URL:-}" ]]; then
    printf '自定义'
  else
    printf 'DeepSeek 官方'
  fi
}

api_key_state() {
  [[ -n "${DEEPSEEK_API_KEY:-}" ]] && printf '已配置' || printf '未配置'
}

read_api_key() {
  local value=""
  if ! is_tty; then
    return 0
  fi
  read -r -s -p "DeepSeek API Key（可留空）: " value || true
  printf '\n'
  DEEPSEEK_API_KEY="$value"
}

interactive_api_config() {
  local mode="${1:-edit}" choice default_choice value
  heading "DeepSeek API 配置"

  if [[ -n "${DEEPSEEK_BASE_URL:-}" ]]; then
    default_choice=2
  else
    default_choice=1
  fi

  if is_tty; then
    cat <<'EOF'
  1) DeepSeek 官方 API
  2) 自定义 Base URL
EOF
    read -r -p "API 接入方式 [$default_choice]: " choice || true
    choice="${choice:-$default_choice}"

    case "$choice" in
      1)
        DEEPSEEK_BASE_URL=""
        ;;
      2)
        while true; do
          read -r -p "自定义 Base URL${DEEPSEEK_BASE_URL:+ [$DEEPSEEK_BASE_URL]}: " value || true
          value="${value:-$DEEPSEEK_BASE_URL}"
          if validate_base_url "$value"; then
            DEEPSEEK_BASE_URL="${value%/}"
            break
          fi
          warn "Base URL 必须以 http:// 或 https:// 开头。"
        done
        ;;
      *)
        warn "无效选项，保持当前 API 接入方式。"
        ;;
    esac

    if [[ -n "${DEEPSEEK_API_KEY:-}" ]]; then
      if confirm "API Key 已配置，是否修改？" N; then
        read_api_key
      fi
    else
      read_api_key
    fi
  fi

  info "API 模式: $(api_mode_label)"
  if [[ -n "${DEEPSEEK_BASE_URL:-}" ]]; then
    info "Base URL: $DEEPSEEK_BASE_URL"
  else
    info "Base URL: DeepSeek 官方默认"
  fi
  info "API Key: $(api_key_state)"
}

interactive_config() {
  local mode="${1:-edit}" value=""

  heading "交互式配置"
  if [[ "$mode" == "initial" ]]; then
    if is_tty; then
      heading "DSH 版本"
      cat <<'EOF'
  1) Standard  通用开发版
  2) Research  一般科研版（Python / Jupyter / Quarto / LaTeX）
EOF
      local edition_choice=""
      read -r -p "选择版本 [1]: " edition_choice || true
      edition_choice="${edition_choice:-1}"
      case "$edition_choice" in
        1)
          DSH_EDITION="standard"
          DSH_RESEARCH_PACK="none"
          DSH_IMAGE="$DEFAULT_IMAGE"
          ;;
        2)
          DSH_EDITION="research"
          heading "Research Pack"
          cat <<'EOF'
  1) None       通用科研
  2) Economics  经济学 / 计量经济学
EOF
          local pack_choice=""
          read -r -p "选择 Research Pack [1]: " pack_choice || true
          pack_choice="${pack_choice:-1}"
          case "$pack_choice" in
            1) DSH_RESEARCH_PACK="none"; DSH_IMAGE="$RESEARCH_IMAGE" ;;
            2) DSH_RESEARCH_PACK="economics"; DSH_IMAGE="$RESEARCH_ECONOMICS_IMAGE" ;;
            *) warn "无效选项，使用通用 Research。"; DSH_RESEARCH_PACK="none"; DSH_IMAGE="$RESEARCH_IMAGE" ;;
          esac
          ;;
        *)
          warn "无效选项，使用 Standard。"
          DSH_EDITION="standard"
          DSH_RESEARCH_PACK="none"
          DSH_IMAGE="$DEFAULT_IMAGE"
          ;;
      esac
    else
      case "${DSH_EDITION:-standard}" in
        research)
          DSH_EDITION="research"
          case "${DSH_RESEARCH_PACK:-none}" in
            economics) DSH_RESEARCH_PACK="economics"; DSH_IMAGE="$RESEARCH_ECONOMICS_IMAGE" ;;
            *) DSH_RESEARCH_PACK="none"; DSH_IMAGE="$RESEARCH_IMAGE" ;;
          esac
          ;;
        *)
          DSH_EDITION="standard"
          DSH_RESEARCH_PACK="none"
          DSH_IMAGE="$DEFAULT_IMAGE"
          ;;
      esac
    fi

    while true; do
      prompt_required DSH_NAME "Docker 容器名称（必填，例如 dsh）"
      if validate_container_name "$DSH_NAME"; then break; fi
      warn "容器名只能包含字母、数字、点、下划线、短横线，且必须以字母或数字开头。"
      DSH_NAME=""
    done

    while true; do
      prompt_required DSH_PORT "Web UI 宿主机端口（必填，例如 3080）"
      if ! validate_port "$DSH_PORT"; then
        warn "请输入 1-65535 之间的端口。"
        DSH_PORT=""
        continue
      fi
      if port_in_use "$DSH_PORT"; then
        warn "端口 $DSH_PORT 当前已有监听。"
        confirm "仍然使用这个端口？" N && break
        DSH_PORT=""
        continue
      fi
      break
    done

    if container_exists; then
      warn "已存在名为 $DSH_NAME 的 Docker 容器。"
      confirm "确认由 dshd 接管并替换这个同名容器？" N || die "请重新安装并选择其他容器名称。"
    fi

    DSH_WORKSPACE="$DEFAULT_WORKSPACE"
    DSH_STORAGE_MODE="bind"
    DSH_DATA_DIR="$DEFAULT_DATA_DIR"
    DSH_VOLUME="${DSH_NAME}-home"
  else
    prompt_value DSH_NAME "容器名称" "$DSH_NAME"
    validate_container_name "$DSH_NAME" || die "容器名称不合法。"
    prompt_value DSH_PORT "宿主机端口" "$DSH_PORT"
    validate_port "$DSH_PORT" || die "端口必须是 1-65535 的数字。"
  fi

  prompt_value DSH_BIND_ADDR "监听地址（127.0.0.1 推荐；0.0.0.0 可供局域网/反代访问）" "${DSH_BIND_ADDR:-$DEFAULT_BIND_ADDR}"

  heading "持久化目录"
  prompt_value DSH_WORKSPACE "项目工作区目录（宿主机 → /workspace）" "$DSH_WORKSPACE"
  [[ "$DSH_WORKSPACE" == /* ]] || die "工作区目录必须使用绝对路径。"

  while true; do
    prompt_value DSH_STORAGE_MODE "DSH 数据存储模式（bind=宿主机目录，volume=Docker 数据卷）" "${DSH_STORAGE_MODE:-$DEFAULT_STORAGE_MODE}"
    case "$DSH_STORAGE_MODE" in
      bind|volume) break ;;
      *) warn "请输入 bind 或 volume。" ;;
    esac
  done
  if [[ "$DSH_STORAGE_MODE" == "bind" ]]; then
    prompt_value DSH_DATA_DIR "DSH 数据目录（宿主机 → /root/.dsh）" "${DSH_DATA_DIR:-$DEFAULT_DATA_DIR}"
    [[ "$DSH_DATA_DIR" == /* ]] || die "DSH 数据目录必须使用绝对路径。"
  else
    prompt_value DSH_VOLUME "Docker 数据卷" "$DSH_VOLUME"
    [[ -n "$DSH_VOLUME" ]] || die "Docker 数据卷名称不能为空。"
  fi

  prompt_value DSH_TRUSTED_HOSTS "Trusted Hosts（多个用逗号分隔，无则留空）" "${DSH_TRUSTED_HOSTS:-}"

  heading "容器运行资源"
  while true; do
    prompt_value DSH_SHM_SIZE "共享内存 /dev/shm（Chromium 推荐 1g）" "${DSH_SHM_SIZE:-$DEFAULT_SHM_SIZE}"
    validate_docker_size "$DSH_SHM_SIZE" && break
    warn "请输入 Docker 大小格式，例如 512m、1g。"
  done

  while true; do
    prompt_value DSH_TIMEZONE "容器时区" "${DSH_TIMEZONE:-$DEFAULT_TIMEZONE}"
    validate_timezone "$DSH_TIMEZONE" && break
    warn "时区格式不合法，例如 Asia/Shanghai、UTC。"
  done

  prompt_value DSH_NPM_CACHE "npm cache 路径（建议放在沙箱可写目录）" "${DSH_NPM_CACHE:-$DEFAULT_NPM_CACHE}"
  [[ "$DSH_NPM_CACHE" == /* ]] || die "npm cache 必须使用绝对路径。"

  local memory_default="${DSH_MEMORY_LIMIT:-off}" swap_default="${DSH_MEMORY_SWAP:-off}"
  prompt_value DSH_MEMORY_LIMIT "容器内存上限（off=不限制，例如 1536m/2g）" "$memory_default"
  [[ "$DSH_MEMORY_LIMIT" == "off" || "$DSH_MEMORY_LIMIT" == "none" || "$DSH_MEMORY_LIMIT" == "0" ]] && DSH_MEMORY_LIMIT=""
  [[ -z "$DSH_MEMORY_LIMIT" ]] || validate_docker_size "$DSH_MEMORY_LIMIT" || die "内存上限格式不合法，例如 1536m、2g 或 off。"

  prompt_value DSH_MEMORY_SWAP "RAM+Swap 总上限（off=Docker 默认；需先设置内存上限）" "$swap_default"
  [[ "$DSH_MEMORY_SWAP" == "off" || "$DSH_MEMORY_SWAP" == "none" || "$DSH_MEMORY_SWAP" == "0" ]] && DSH_MEMORY_SWAP=""
  [[ -z "$DSH_MEMORY_SWAP" ]] || validate_docker_size "$DSH_MEMORY_SWAP" || die "memory-swap 格式不合法，例如 2g、3g 或 off。"
  if [[ -n "$DSH_MEMORY_SWAP" && -z "$DSH_MEMORY_LIMIT" ]]; then
    warn "未设置内存上限，memory-swap 将被清空。"
    DSH_MEMORY_SWAP=""
  elif [[ -n "$DSH_MEMORY_SWAP" && -n "$DSH_MEMORY_LIMIT" ]]; then
    local memory_bytes swap_bytes
    memory_bytes="$(docker_size_bytes "$DSH_MEMORY_LIMIT")"
    swap_bytes="$(docker_size_bytes "$DSH_MEMORY_SWAP")"
    (( swap_bytes >= memory_bytes )) || die "RAM+Swap 总上限不能小于内存上限。"
  fi

  interactive_api_config "$mode"

  if [[ "$mode" == "initial" ]]; then
    heading "Docker 项目管理"
    warn "开启后 DSH 会挂载宿主机 Docker Socket，可构建、部署和删除宿主机容器。"
    warn "Docker Socket 权限基本等价于宿主机 root，请只在你信任 DSH 执行内容时开启。"
    if confirm "是否允许 DSH 管理宿主机 Docker？" N; then
      DSH_DOCKER_ACCESS=true
    else
      DSH_DOCKER_ACCESS=false
    fi
  fi

  if [[ "$DSH_BIND_ADDR" == "0.0.0.0" ]]; then
    warn "不要直接把 DSH Web UI 裸露公网，推荐 Nginx/Caddy + HTTPS。"
    [[ -n "$DSH_TRUSTED_HOSTS" ]] || warn "当前未配置 Trusted Hosts。"
  fi
}

# ---------- 脚本自更新 ----------
# 每次运行 dshd 时检查上游是否有新脚本，有则替换自身并用新脚本重新执行同一命令。
# 关闭: DSHD_NO_SELF_UPDATE=1 ；自定义源: DSHD_UPDATE_URL=<url> ；调退避: DSHD_SELF_UPDATE_RETRY_DELAY=<秒>

self_update_enabled() {
  case "${DSHD_NO_SELF_UPDATE:-0}" in
    1|true|yes|on) return 1 ;;
  esac
  return 0
}

# 输出自身脚本的绝对路径；通过管道执行（BASH_SOURCE 为空）时返回失败。
resolve_self_path() {
  local path="$SELF_PATH" dir base
  [[ -n "$path" && -f "$path" ]] || return 1
  dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd)" || return 1
  base="$(basename "$path")"
  [[ -n "$dir" && -n "$base" ]] || return 1
  printf '%s/%s' "$dir" "$base"
}

fetch_url_to() {
  local url="$1" dest="$2"
  # 由 shell 负责写入：curl/wget 只输出到 stdout，避免各平台对 -o 路径解析的差异。
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 4 --max-time 20 "$url" >"$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --timeout=20 -O - "$url" >"$dest"
  else
    return 127
  fi
}

script_version_of() {
  local file="$1" line=""
  line="$(grep -m1 '^DSHD_VERSION=' "$file" 2>/dev/null || true)"
  line="${line#DSHD_VERSION=}"
  line="${line%\"}"
  line="${line#\"}"
  printf '%s' "$line"
}

# 把 x.y.z 折算成可比较的整数（预发布后缀忽略，如 1.2.3-rc.1 -> 1.2.3）。
version_score() {
  local v="${1%%-*}" score=0 count=0 p
  local IFS='.'
  local -a parts
  read -r -a parts <<<"$v"
  for p in "${parts[@]}"; do
    [[ "$p" =~ ^[0-9]+$ ]] || p=0
    score=$(( score * 1000 + 10#$p ))
    count=$(( count + 1 ))
    if (( count >= 3 )); then
      break
    fi
  done
  while (( count < 3 )); do
    score=$(( score * 1000 ))
    count=$(( count + 1 ))
  done
  printf '%s' "$score"
}

# 下载结果必须像一份完整的 dshd，才允许覆盖当前脚本。
validate_self_script() {
  local file="$1" first_line=""
  [[ -s "$file" ]] || return 1
  IFS= read -r first_line <"$file" || true
  [[ "$first_line" == *bash* ]] || return 1
  grep -q '^DSHD_VERSION=' "$file" 2>/dev/null || return 1
  bash -n "$file" 2>/dev/null || return 1
  return 0
}

self_update_sources() {
  if [[ -n "${DSHD_UPDATE_URL:-}" ]]; then
    printf '%s\n' "$DSHD_UPDATE_URL"
    return 0
  fi
  printf '%s\n' "${RAW_BASE}/dshd"
  printf '%s\n' "${CDN_BASE}/dshd"
}

update_backoff_active() {
  local marker="$STATE_DIR/.self-update-failed" last now
  [[ -f "$marker" ]] || return 1
  [[ "$SELF_UPDATE_RETRY_DELAY" =~ ^[0-9]+$ ]] || return 1
  [[ "$SELF_UPDATE_RETRY_DELAY" -gt 0 ]] || return 1
  last="$(head -n 1 "$marker" 2>/dev/null || true)"
  [[ "$last" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  [[ $((now - last)) -lt "$SELF_UPDATE_RETRY_DELAY" ]]
}

write_update_marker() {
  local file="$1" value="$2"
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  printf '%s\n' "$value" >"$file" 2>/dev/null || true
}

install_new_self() {
  local src="$1" dest="$2"
  local sudo_args=(-n)
  if [[ -w "$dest" ]]; then
    mv "$src" "$dest"
    return 0
  fi
  command -v sudo >/dev/null 2>&1 || return 1
  if is_tty; then
    sudo_args=()
  fi
  sudo "${sudo_args[@]}" install -m 0755 "$src" "$dest" 2>/dev/null
}

self_update() {
  local mode="${1:-auto}" self failmark tmpdir tmp url ok=0 newver retry_hint
  shift || true
  local force=0
  if [[ "$mode" == "force" ]]; then
    force=1
  fi

  # 本次进程已被自更新重新拉起，不再重复检查。
  [[ "${DSHD_SELF_UPDATED:-0}" == "1" ]] && return 0
  if [[ "$force" -ne 1 ]] && ! self_update_enabled; then
    return 0
  fi

  self="$(resolve_self_path)" || return 0
  if [[ "$force" -ne 1 ]] && update_backoff_active; then
    return 0
  fi

  failmark="$STATE_DIR/.self-update-failed"
  tmpdir="$(mktemp -d 2>/dev/null)" || return 0
  tmp="$tmpdir/dshd.new"

  while IFS= read -r url; do
    [[ -n "$url" ]] || continue
    if fetch_url_to "$url" "$tmp" && validate_self_script "$tmp"; then
      ok=1
      break
    fi
    rm -f "$tmp"
  done < <(self_update_sources)

  if [[ "$ok" -ne 1 ]]; then
    rm -rf "$tmpdir"
    write_update_marker "$failmark" "$(date +%s)"
    if [[ "$SELF_UPDATE_RETRY_DELAY" =~ ^[0-9]+$ ]] && [[ "$SELF_UPDATE_RETRY_DELAY" -gt 0 ]]; then
      retry_hint="（${SELF_UPDATE_RETRY_DELAY}s 后重试）"
    fi
    warn "自更新检查失败，继续使用本地 dshd $DSHD_VERSION${retry_hint}"
    return 0
  fi

  if cmp -s "$tmp" "$self"; then
    rm -rf "$tmpdir"
    rm -f "$failmark" 2>/dev/null || true
    if [[ "$force" -eq 1 ]]; then
      ok "dshd 已是最新版本 $DSHD_VERSION"
    fi
    return 0
  fi

  newver="$(script_version_of "$tmp")"

  # 自动模式下不做降级：上游版本低于本地时保持现状（本地可能是更新的开发版本）。
  if [[ "$force" -ne 1 ]]; then
    local remote_score local_score
    if [[ -z "$newver" ]]; then
      rm -rf "$tmpdir"
      return 0
    fi
    remote_score="$(version_score "$newver")"
    local_score="$(version_score "$DSHD_VERSION")"
    if (( remote_score < local_score )); then
      rm -rf "$tmpdir"
      return 0
    fi
  fi

  chmod 0755 "$tmp" 2>/dev/null || true

  if ! install_new_self "$tmp" "$self"; then
    rm -rf "$tmpdir"
    warn "发现新版本 ${newver:-未知}，但无权限写入 $self。"
    warn "请用 root 运行 dshd，或手动执行: sudo dshd self-update"
    return 0
  fi

  rm -rf "$tmpdir"
  rm -f "$failmark" 2>/dev/null || true
  ok "dshd 已更新: $DSHD_VERSION → ${newver:-未知}"

  if [[ "${DSHD_LIB_ONLY:-0}" == "1" ]]; then
    return 0
  fi
  # 用新脚本重新执行同一命令：bash 可能仍在读取旧文件，必须换进程。
  DSHD_SELF_UPDATED=1
  export DSHD_SELF_UPDATED
  exec "$self" "$@"
}

cmd_self_update() {
  # 更新成功时 self_update 会 exec 成新版 `dshd version`，直接显示新版本号。
  self_update force version
  ok "dshd 当前版本 $DSHD_VERSION"
}

install_self() {
  local source="${BASH_SOURCE[0]}" target="/usr/local/bin/dshd"
  [[ "$source" == "$target" ]] && return 0
  if [[ -r "$source" ]]; then
    info "安装管理命令到 $target ..."
    as_root install -m 0755 "$source" "$target"
    ok "以后直接输入 dshd 即可进入管理菜单"
  else
    warn "无法读取当前脚本，跳过安装 dshd 命令。"
  fi
}

cmd_install() {
