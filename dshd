menu_category() {
  local category="$1" choice="" rc=0 action_rc=0
  while true; do
    clear 2>/dev/null || true
    menu_render_category "$category"
    rc=0
    menu_read choice '请选择 (0 返回): ' || rc=$?
    if (( rc == 2 )); then continue; fi
    (( rc == 0 )) || return 0
    case "$choice" in 0|'') return 0 ;; esac
    action_rc=0
    menu_category_action "$category" "$choice" || action_rc=$?
    if (( action_rc != 10 )); then menu_pause; fi
    load_config_guarded || warn '配置读取失败，部分操作可能不可用。'
  done
}

menu_legacy() {
  DSHD_MENU_ACTIVE=1
  export DSHD_MENU_ACTIVE
  menu_signal_guard
  if ! load_config_guarded; then
    err "无法加载 dshd 配置，菜单已退出。"
    return 1
  fi
  local choice="" rc=0 category=""
  while true; do
    clear 2>/dev/null || true
    menu_render_legacy_main
    rc=0
    if menu_colors_enabled; then
      menu_read choice $'\n\033[1;36m›\033[0m 请选择: ' || rc=$?
    else
      menu_read choice $'\n请选择: ' || rc=$?
    fi
    if (( rc == 2 )); then continue; fi
    (( rc == 0 )) || return 0
    case "$choice" in
      1|01) category=instances ;;
      2|02) category=runtime ;;
      3|03) category=versions ;;
      4|04) category=config ;;
      5|05) category=network ;;
      6|06) category=data ;;
      0|'') return 0 ;;
      *) warn '无效选项'; continue ;;
    esac
    menu_category "$category"
    load_config_guarded || warn '当前配置存在问题，部分操作可能不可用。'
  done
}

# Phase 4: default terminal UI is a small rescue console.
