validate_env_name() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

ensure_container_env_file() {
  ensure_state_dir
  if [[ ! -e "$CONTAINER_ENV_FILE" ]]; then
    : >"$CONTAINER_ENV_FILE"
  fi
  chmod 600 "$CONTAINER_ENV_FILE"
}

container_env_changed() {
  ok "容器环境变量已更新。"
  if container_exists; then
    if is_tty && confirm "是否立即重建容器使配置生效？" Y; then
      create_container
    else
      info "运行 dshd recreate 后生效。"
    fi
  fi
