  validate_proxy_node_name "$1" || return 1
  printf '%s/%s.json' "$PROXY_NODES_DIR" "$1"
}

proxy_node_exists() {
  local file
  file="$(proxy_node_file "$1" 2>/dev/null || true)"
  [[ -n "$file" && -f "$file" ]]
}

proxy_node_count() {
  [[ -d "$PROXY_NODES_DIR" ]] || { printf '0'; return; }
  find "$PROXY_NODES_DIR" -maxdepth 1 -type f -name '*.json' 2>/dev/null | wc -l | tr -d ' '
}

proxy_node_description() {
  local name="$1" file type server port
  file="$(proxy_node_file "$name" 2>/dev/null || true)"
  [[ -n "$file" && -f "$file" ]] || { printf 'unknown'; return; }
  type="$(grep -oE '"type"[[:space:]]*:[[:space:]]*"[^"]+"' "$file" | head -1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
  server="$(grep -oE '"server"[[:space:]]*:[[:space:]]*"[^"]+"' "$file" | head -1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
  port="$(grep -oE '"server_port"[[:space:]]*:[[:space:]]*[0-9]+' "$file" | head -1 | grep -oE '[0-9]+$' || true)"
  type="${type:-unknown}"
  if [[ -n "$server" && -n "$port" ]]; then
    printf '%s://%s:%s' "$type" "$server" "$port"
  elif [[ -n "$server" ]]; then
    printf '%s://%s' "$type" "$server"
  else
    printf '%s' "$type"
  fi
}

proxy_list_nodes() {
  if [[ ! -d "$PROXY_NODES_DIR" ]]; then
    info "尚未添加代理节点。"
    return
  fi
  local file name found=0 marker
  for file in "$PROXY_NODES_DIR"/*.json; do
    [[ -f "$file" ]] || continue
    found=1
    name="$(basename "$file" .json)"
    marker=" "
    [[ "$name" == "$DSH_PROXY_NODE" ]] && marker="*"
    local last=""
    last="$(proxy_last_result "$name" 2>/dev/null || true)"
    if [[ -n "$last" ]]; then
      printf '  %s %-18s %-9s %s\n' "$marker" "$name" "$last" "$(proxy_node_description "$name")"
    else
      printf '  %s %-18s %-9s %s\n' "$marker" "$name" "--" "$(proxy_node_description "$name")"
    fi
  done
  (( found == 1 )) || info "尚未添加代理节点。"
  if [[ "$DSH_PROXY_FAILOVER_ENABLED" == "true" ]]; then
    printf '\n  * = 首选种子；自动模式实际出口由 sing-box URLTest 选择。凭据不会显示。\n'
  else
    printf '\n  * = 当前节点；凭据不会显示。\n'
  fi
}

