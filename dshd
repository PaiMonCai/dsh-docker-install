}
cmd_token() {
  load_config; ensure_docker
  container_exists || die "容器不存在。"
  local url public_url
  url="$(docker_cmd logs "$DSH_NAME" 2>&1 | grep -oE 'http://[^ ]*\?token=[A-Za-z0-9_-]+' | tail -1 || true)"
  [[ -n "$url" ]] || die "未从日志找到 token URL。"

  public_url="$(public_token_url "$url" 2>/dev/null || true)"
  if [[ -n "$public_url" ]]; then
    printf '%s\n' "$public_url"
  else
    local_token_url "$url"
    printf '\n'
  fi
}
dashboard_container_name() {
  printf '%s-dashboard' "$DSH_NAME"
}

dashboard_project_path() {
  local raw="${1:-.}"
  case "$raw" in
    *..*) return 1 ;;
    /workspace) printf '/workspace'; return 0 ;;
    /workspace/*) printf '%s' "$raw"; return 0 ;;
    /*) return 1 ;;
  esac
  raw="${raw#./}"
  [[ -n "$raw" && "$raw" != "." ]] && printf '/workspace/%s' "$raw" || printf '/workspace'
}

dashboard_container_exists() {
  local name
  name="$(dashboard_container_name)"
  docker_cmd ps -a --format '{{.Names}}' | grep -Fxq "$name"
}

dashboard_container_running() {
  local name
  name="$(dashboard_container_name)"
  docker_cmd ps --format '{{.Names}}' | grep -Fxq "$name"
}

cmd_dashboard() {
  load_config
  ensure_docker
  local action="${1:-status}"
  shift || true
  [[ "$DSH_EDITION" == "research" ]] || die "Research Dashboard 仅适用于 Research Edition。"

  local name url
  name="$(dashboard_container_name)"
  url="http://127.0.0.1:${DSH_RESEARCH_DASHBOARD_PORT}/"

  case "$action" in
    status|show)
      heading "Research Dashboard"
      printf '容器:   %s\n' "$name"
      printf '状态:   %s\n' "$(dashboard_container_running && echo running || echo stopped)"
      printf 'URL:    %s\n' "$url"
      printf '端口:   127.0.0.1:%s -> 8765\n' "$DSH_RESEARCH_DASHBOARD_PORT"
      if dashboard_container_running && command -v curl >/dev/null 2>&1; then
        if curl -fsS --connect-timeout 2 --max-time 4 "${url}api/meta" >/dev/null 2>&1; then
          ok "Dashboard API 可访问"
        else
          warn "Dashboard 容器在运行，但 API 尚不可访问。"
        fi
      fi
      return
      ;;
    start)
      local raw_project="${1:-.}" project
      project="$(dashboard_project_path "$raw_project")" \
        || die "Dashboard project 必须位于 /workspace 内，且不能包含 '..': $raw_project"

      if dashboard_container_exists; then
        docker_cmd rm -f "$name" >/dev/null
      fi
      if port_in_use "$DSH_RESEARCH_DASHBOARD_PORT"; then
        die "宿主机端口 $DSH_RESEARCH_DASHBOARD_PORT 已被占用；可执行 dshd dashboard port <PORT> 修改。"
      fi

      heading "启动 Research Dashboard"
      info "Project: $project"
      info "Host URL: $url"
      docker_cmd run -d \
        --name "$name" \
        --restart unless-stopped \
        -p "127.0.0.1:${DSH_RESEARCH_DASHBOARD_PORT}:8765" \
        -e PYTHONDONTWRITEBYTECODE=1 \
        -v "${DSH_WORKSPACE}:/workspace:ro" \
        --entrypoint research-dashboard \
        "$DSH_IMAGE" \
        --project "$project" \
        --host 0.0.0.0 \
        --port 8765 \
        --allow-remote \
        --quiet >/dev/null

      local i
      for i in $(seq 1 30); do
        if ! dashboard_container_running; then
          err "Dashboard 容器已退出。最近日志："
          docker_cmd logs --tail 60 "$name" 2>&1 || true
          return 1
        fi
        if command -v curl >/dev/null 2>&1 \
          && curl -fsS --connect-timeout 1 --max-time 2 "${url}api/meta" >/dev/null 2>&1; then
          ok "Research Dashboard 已就绪: $url"
          printf '远程 SSH 访问可使用：\n  ssh -L %s:127.0.0.1:%s <server>\n' \
            "$DSH_RESEARCH_DASHBOARD_PORT" "$DSH_RESEARCH_DASHBOARD_PORT"
          return 0
        fi
        sleep 1
      done
      warn "Dashboard 容器仍在运行，但 30 秒内未通过 HTTP 检查。"
      docker_cmd logs --tail 60 "$name" 2>&1 || true
      return 1
      ;;
    stop)
      if dashboard_container_exists; then
        docker_cmd rm -f "$name" >/dev/null
        ok "Research Dashboard 已停止并移除。"
      else
        info "Research Dashboard 未运行。"
      fi
      return
      ;;
    restart)
      local project="${1:-.}"
      cmd_dashboard stop
      cmd_dashboard start "$project"
      return
      ;;
    logs)
      dashboard_container_exists || die "Dashboard 容器不存在。"
      docker_cmd logs -f --tail 200 "$name"
      return
      ;;
    port)
      local new_port="${1:-}"
      validate_port "$new_port" || die "用法: dshd dashboard port <1-65535>"
      DSH_RESEARCH_DASHBOARD_PORT="$new_port"
      save_config
      ok "Dashboard 宿主机端口已设置为 $DSH_RESEARCH_DASHBOARD_PORT。"
      if dashboard_container_exists; then
        warn "现有 Dashboard 需要重新 start 才能使用新端口。"
      fi
      return
      ;;
    *)
      die "未知 dashboard 子命令: $action（可用: status/start/stop/restart/logs/port）"
      ;;
  esac
}

cmd_storage() {
  load_config; ensure_docker
  local action="${1:-show}"
  shift || true

  case "$action" in
    show|status)
      heading "DSH 持久化存储"
      printf '模式:       %s\n' "$DSH_STORAGE_MODE"
      printf '宿主机来源: %s\n' "$(storage_source)"
      printf '容器路径:   /root/.dsh\n'
      printf '工作区:     %s -> /workspace\n' "$DSH_WORKSPACE"
      return
      ;;
    bind)
      local target="${1:-$DEFAULT_DATA_DIR}"
      [[ "$target" == /* ]] || die "bind 目录必须使用绝对路径。"
      if ! mkdir -p "$target" 2>/dev/null; then
        as_root mkdir -p "$target"
      fi
      if [[ "$DSH_STORAGE_MODE" == "volume" ]] \
        && docker_cmd volume inspect "$DSH_VOLUME" >/dev/null 2>&1 \
        && [[ -z "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
        die "目标目录为空。若要从旧 volume 迁移数据，请使用: dshd storage migrate $target"
      fi
      DSH_STORAGE_MODE="bind"
      DSH_DATA_DIR="$target"
      save_config
      ok "已切换为 bind mount: $DSH_DATA_DIR -> /root/.dsh"
      if container_exists; then
        if confirm "是否立即重建容器应用新存储？" Y; then
          create_container
        else
          warn "配置已保存；稍后执行 dshd recreate。"
        fi
      fi
      return
      ;;
    migrate)
      [[ "$DSH_STORAGE_MODE" == "volume" ]] || die "当前不是 named volume 模式，无需 migrate。"
      local target="${1:-$DEFAULT_DATA_DIR}"
      [[ "$target" == /* ]] || die "迁移目标必须使用绝对路径。"
      if [[ -d "$target" && -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
        die "目标目录非空: $target。若你已经手工复制完成，请使用: dshd storage bind $target"
      fi
      if ! mkdir -p "$target" 2>/dev/null; then
        as_root mkdir -p "$target"
      fi

      local was_running=false
      if container_running; then
        was_running=true
        info "停止容器以获得一致的数据快照..."
        docker_cmd stop "$DSH_NAME" >/dev/null
      fi

      heading "迁移 DSH 数据"
      info "来源: volume:$DSH_VOLUME"
      info "目标: bind:$target"
      if ! docker_cmd run --rm --entrypoint sh \
        -v "${DSH_VOLUME}:/from:ro" \
        -v "${target}:/to" \
        "$DSH_IMAGE" \
        -c 'cp -a /from/. /to/'; then
        [[ "$was_running" == "true" ]] && docker_cmd start "$DSH_NAME" >/dev/null || true
        die "数据复制失败；原 named volume 未修改。"
      fi

      DSH_STORAGE_MODE="bind"
      DSH_DATA_DIR="$target"
      save_config
      ok "数据迁移完成，旧 volume $DSH_VOLUME 仍保留作为回退。"
      create_container
      return
      ;;
    volume)
      local volume_name="${1:-$DSH_VOLUME}"
      [[ -n "$volume_name" ]] || die "volume 名称不能为空。"
      if [[ "$DSH_STORAGE_MODE" == "bind" ]] && ! docker_cmd volume inspect "$volume_name" >/dev/null 2>&1; then
        warn "目标 named volume 尚不存在；此命令不会自动复制 bind 目录数据。"
        confirm "仍然创建空 volume 并切换？" N || return 0
      fi
      DSH_STORAGE_MODE="volume"
      DSH_VOLUME="$volume_name"
      ensure_storage
      save_config
      ok "已切换为 named volume: $DSH_VOLUME -> /root/.dsh"
      if container_exists; then
        if confirm "是否立即重建容器应用新存储？" Y; then
          create_container
        else
          warn "配置已保存；稍后执行 dshd recreate。"
        fi
      fi
      return
      ;;
    *)
      die "未知 storage 子命令: $action（可用: show/bind/migrate/volume）"
      ;;
  esac
}

cmd_mounts() {
  load_config
  local action="${1:-show}"

  case "$action" in
    show|list)
      heading "自定义持久化挂载"
      printf '配置文件: %s\n' "$MOUNTS_FILE"
      if [[ ! -s "$MOUNTS_FILE" ]]; then
        info "当前没有自定义持久化挂载。"
        return 0
      fi
      local source target mode index=0
      while IFS='|' read -r source target mode _; do
        [[ -n "$source" && "$source" != \#* ]] || continue
        index=$((index + 1))
        printf '\n  %d. %s\n     -> %s\n     模式: %s\n' "$index" "$source" "$target" "${mode:-rw}"
      done <"$MOUNTS_FILE"
      ;;
    add)
      local source="${2:-}" target="${3:-}" mode="${4:-rw}"
      if [[ -z "$source" || -z "$target" ]]; then
        if ! is_tty; then
          die "用法: dshd mounts add HOST_DIR CONTAINER_DIR [rw|ro]"
        fi
        read -r -p "宿主机目录: " source
        read -r -p "容器目标目录: " target
        read -r -p "模式 [rw/ro，默认 rw]: " mode
        mode="${mode:-rw}"
      fi
      require_custom_mount "$source" "$target" "$mode"
      custom_mount_target_conflict "$target" && die "该目标路径与已有自定义挂载重叠: $target"
      prepare_custom_mount_source "$source" "$target"

      if docker_ready && container_running && [[ -z "$(find "$source" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
        if docker_cmd exec "$DSH_NAME" sh -c '
          target="$1"
          [ -d "$target" ] && [ -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]
        ' sh "$target" >/dev/null 2>&1; then
          warn "检测到当前容器 $target 已有数据，而宿主机目录为空。"
          if confirm "先把现有数据迁移到 $source 再启用挂载？" Y; then
            docker_cmd cp "${DSH_NAME}:${target}/." "${source}/"
            [[ "$target" == "/root/.ssh" ]] && as_root chmod 700 "$source" 2>/dev/null || true
            ok "已迁移: $target -> $source"
          else
            warn "未迁移现有数据；重建后新挂载会遮住容器当前的 $target。"
          fi
        fi
      fi

      add_custom_mount_record "$source" "$target" "$mode"
      ok "已添加自定义持久化挂载: $source -> $target ($mode)"
      info "自定义挂载不包含在 dshd backup / restore 中，请单独备份敏感数据。"
      if container_exists && is_tty && confirm "立即重建容器使挂载生效？" N; then
        cmd_recreate
      else
        info "执行 dshd recreate 后生效。"
      fi
      ;;
    remove|rm|delete)
      local target="${2:-}"
      if [[ -z "$target" ]]; then
        if ! is_tty; then
          die "用法: dshd mounts remove CONTAINER_DIR"
        fi
        cmd_mounts show
        read -r -p "请输入要删除的容器目标目录: " target
      fi
      [[ -n "$target" ]] || die "容器目标目录不能为空。"
      remove_custom_mount_record "$target" || die "没有找到目标挂载: $target"
      ok "已删除自定义挂载配置: $target"
      info "宿主机中的原始数据不会被删除。"
      if container_exists && is_tty && confirm "立即重建容器使修改生效？" N; then
        cmd_recreate
      else
        info "执行 dshd recreate 后生效。"
      fi
      ;;
    *)
      die "未知 mounts 子命令: $action（可用: show/add/remove）"
      ;;
  esac
}

cmd_mounts_menu() {
  while true; do
    cmd_mounts show
    cat <<'EOF'

  1) 添加挂载
  2) 删除挂载
  0) 返回
EOF
    local choice=""
    read -r -p $'\n请选择: ' choice || return
    case "$choice" in
      1) cmd_mounts add ;;
      2) cmd_mounts remove ;;
      0) return ;;
      *) warn "无效选项" ;;
    esac
    read -r -p $'\n按 Enter 继续...' _ || true
  done
}


cmd_backup() {
  load_config; ensure_docker; ensure_state_dir; ensure_storage
  local ts file source
  ts="$(date +%Y%m%d-%H%M%S)"
  file="$BACKUP_DIR/${DSH_NAME}-data-${ts}.tar.gz"
  source="$(storage_source)"
  heading "备份 DSH 持久化数据"
  info "来源: $(storage_label)"
  info "目标: $file"
  docker_cmd run --rm --entrypoint sh \
    -v "${source}:/data:ro" \
    -v "${BACKUP_DIR}:/backup" \
    "$DSH_IMAGE" \
    -c "tar czf '/backup/$(basename "$file")' -C /data ." >/dev/null
  ok "备份完成: $file"
}
cmd_restore() {
  load_config; ensure_docker; ensure_state_dir; ensure_storage
  local file="${1:-}"
  if [[ -z "$file" ]]; then
    heading "可用备份"
    ls -1t "$BACKUP_DIR"/*.tar.gz 2>/dev/null || die "没有找到备份文件。"
    if is_tty; then read -r -p "请输入要恢复的完整备份路径: " file; else die "非交互模式请指定备份文件: dshd restore /path/file.tar.gz"; fi
  fi
  [[ -f "$file" ]] || die "备份文件不存在: $file"
  confirm "恢复会覆盖 $(storage_label) 的现有内容，确认继续？" N || return 0
  container_running && docker_cmd stop "$DSH_NAME" >/dev/null || true
  local dir base source
  dir="$(cd "$(dirname "$file")" && pwd)"
  base="$(basename "$file")"
  source="$(storage_source)"
  docker_cmd run --rm --entrypoint sh \
    -v "${source}:/data" \
    -v "${dir}:/backup:ro" \
    "$DSH_IMAGE" \
    -c "rm -rf /data/* /data/.[!.]* /data/..?* 2>/dev/null || true; tar xzf '/backup/${base}' -C /data"
  ok "持久化数据恢复完成"
  cmd_start
}
cmd_doctor() {
  load_config
  heading "dshd 诊断"
  detect_os
  printf '系统: %s\n' "$OS_PRETTY"
  printf 'dshd: %s\n' "$DSHD_VERSION"
  if command -v docker >/dev/null 2>&1; then ok "docker 命令存在: $(docker --version 2>/dev/null || true)"; else err "docker 命令不存在"; fi
  if docker_ready; then ok "Docker daemon 可访问"; else err "Docker daemon 不可访问"; fi
  network_report
  if docker_ready; then
    cmd_status

    if [[ "$DSH_PROXY_ENABLED" == "true" ]]; then
      if ! proxy_node_exists "$DSH_PROXY_NODE"; then
        err "代理已启用，但当前节点不存在: ${DSH_PROXY_NODE:-（空）}"
      elif proxy_container_running; then
        ok "sing-box sidecar 正在运行: $(proxy_container_name)"
        if container_running; then
          local runtime_https_proxy
          runtime_https_proxy="$(docker_cmd exec "$DSH_NAME" sh -c 'printf "%s" "${HTTPS_PROXY:-}"' 2>/dev/null || true)"
          if [[ "$runtime_https_proxy" == "http://dsh-proxy:${DSH_PROXY_PORT}" ]]; then
            ok "DSH HTTPS_PROXY 已指向 sing-box mixed 入口"
          else
            warn "DSH 代理环境未正确应用；期望 http://dsh-proxy:${DSH_PROXY_PORT}，实际 ${runtime_https_proxy:-未设置}。"
          fi
          proxy_test_runtime >/dev/null 2>&1 && ok "代理出口连通测试通过" || warn "代理出口连通测试失败；可执行 dshd proxy test 查看。"
        fi
      else
        err "代理已启用，但 sing-box sidecar 未运行。"
      fi
    else
      ok "代理出口未启用（直连模式）"
    fi

    if [[ -s "$MOUNTS_FILE" ]]; then
      local mount_source mount_target mount_mode invalid_mounts=0 runtime_mount_targets=""
      container_running && runtime_mount_targets="$(docker_cmd inspect -f '{{range .Mounts}}{{println .Destination}}{{end}}' "$DSH_NAME" 2>/dev/null || true)"
      while IFS='|' read -r mount_source mount_target mount_mode _; do
        [[ -n "$mount_source" && "$mount_source" != \#* ]] || continue
        mount_mode="${mount_mode:-rw}"
        if ! validate_custom_mount "$mount_source" "$mount_target" "$mount_mode"; then
          warn "自定义挂载配置无效: $MOUNT_VALIDATION_ERROR"
          invalid_mounts=$((invalid_mounts + 1))
          continue
        fi
        if [[ ! -d "$mount_source" ]]; then
          warn "自定义挂载源目录不存在: $mount_source"
          invalid_mounts=$((invalid_mounts + 1))
        elif container_running && ! grep -Fxq "$mount_target" <<<"$runtime_mount_targets"; then
          warn "自定义挂载尚未应用到当前容器: $mount_source -> $mount_target；执行 dshd recreate。"
        fi
      done <"$MOUNTS_FILE"
      if (( invalid_mounts == 0 )); then
        ok "自定义持久化挂载配置正常: $(custom_mount_count) 项"
      fi
    fi

    if container_running; then
      local workspace_state
      workspace_state="$(docker_cmd exec "$DSH_NAME" sh -c '
        canonical=/workspace
        legacy=/root/dsh
        legacy_sessions="${DSH_HOME:-/root/.dsh}/sessions/--root-dsh--"
        if [ ! -d "$canonical" ]; then
          printf "%s\n" canonical-missing
        elif [ -L "$legacy" ]; then
          printf "repaired:%s\n" "$(readlink "$legacy" 2>/dev/null || true)"
        elif [ ! -e "$legacy" ] && [ -d "$legacy_sessions" ]; then
          printf "%s\n" stale
        elif [ -e "$legacy" ]; then
          printf "%s\n" legacy-present
        else
          printf "%s\n" ok
        fi
      ' 2>/dev/null || true)"
      case "$workspace_state" in
        canonical-missing)
          warn "标准工作区 /workspace 不存在；请检查容器挂载。"
          ;;
        repaired:*)
          ok "Workspace 自愈已生效: /root/dsh -> ${workspace_state#repaired:}"
          ;;
        stale)
          warn "检测到历史会话 cwd=/root/dsh，但路径已失效；当前运行镜像可能尚未包含 Workspace 自动修复。"
          ;;
        legacy-present)
          warn "检测到实体目录 /root/dsh；它若不在持久挂载中，recreate 后仍可能丢失。"
          ;;
        ok)
          ok "Workspace 持久化路径正常: /workspace"
          ;;
      esac
    fi
    if container_running; then
      local shm_bytes runtime_tz runtime_npm_cache sensitive_env_count mutable_git_deps
      shm_bytes="$(docker_cmd inspect -f '{{.HostConfig.ShmSize}}' "$DSH_NAME" 2>/dev/null || true)"
      [[ "$shm_bytes" =~ ^[0-9]+$ ]] || shm_bytes=0
      if (( shm_bytes >= 536870912 )); then
        ok "共享内存充足: $((shm_bytes / 1024 / 1024)) MiB"
      else
        warn "共享内存偏小: $((shm_bytes / 1024 / 1024)) MiB；Chromium/Playwright 建议至少 512 MiB（默认配置 1g）。"
      fi

      runtime_tz="$(docker_cmd exec "$DSH_NAME" sh -c 'printf "%s" "${TZ:-}"' 2>/dev/null || true)"
      if [[ "$runtime_tz" == "$DSH_TIMEZONE" ]]; then
        ok "容器时区正常: $runtime_tz"
      else
        warn "容器时区未应用：期望 $DSH_TIMEZONE，实际 ${runtime_tz:-未设置}；执行 dshd recreate。"
      fi

      runtime_npm_cache="$(docker_cmd exec "$DSH_NAME" npm config get cache 2>/dev/null | tail -1 || true)"
      if [[ "$runtime_npm_cache" == "$DSH_NPM_CACHE" ]]; then
        ok "npm cache 位于沙箱可写路径: $runtime_npm_cache"
      else
        warn "npm cache 与配置不一致：期望 $DSH_NPM_CACHE，实际 ${runtime_npm_cache:-未知}。"
      fi

      mutable_git_deps="$(docker_cmd exec "$DSH_NAME" sh -c '
        count=0
        for f in "${DSH_HOME:-/root/.dsh}"/profiles/*/package.json; do
          [ -f "$f" ] || continue
          n="$(grep -Ec '"'"'"[^"]+"[[:space:]]*:[[:space:]]*"github:[^"#]+"'"'"' "$f" 2>/dev/null || true)"
          count=$((count + n))
        done
        printf "%s" "$count"
      ' 2>/dev/null || echo 0)"
      [[ "$mutable_git_deps" =~ ^[0-9]+$ ]] || mutable_git_deps=0
      if (( mutable_git_deps > 0 )); then
        warn "检测到 $mutable_git_deps 个未固定 commit/tag 的 github: 依赖；重装时可能随上游分支漂移，建议使用 #<commit> 固定。"
      fi

      local hub_route hub_source hub_client hub_root hub_token hub_host hub_post_code
      hub_route="$(docker_cmd exec "$DSH_NAME" sh -c '
        find "${DSH_HOME:-/root/.dsh}/profiles" -path "*/node_modules/dsh-plugin/lib/http/routes.js" -type f -print -quit 2>/dev/null
      ' 2>/dev/null || true)"
      if [[ -n "$hub_route" ]]; then
        hub_root="${hub_route%/lib/http/routes.js}"

        if docker_cmd exec "$DSH_NAME" grep -Fq '.split(/[,s]+/)' "$hub_route" 2>/dev/null; then
          warn "Plugin Hub 反代 Origin patch 存在旧版拆分错误（[,s]）；Trusted Hosts 会被错误切碎并导致 403。执行 dshd restart/update 让新版 runtime patch 自动迁移。"
        elif docker_cmd exec "$DSH_NAME" grep -q 'DSH_TRUSTED_HOSTS' "$hub_route" 2>/dev/null \
          && docker_cmd exec "$DSH_NAME" grep -q 'trustedHosts.has(host)' "$hub_route" 2>/dev/null; then
          ok "Plugin Hub 反代 Origin patch 代码已生效（复用 DSH_TRUSTED_HOSTS）"
        elif [[ -n "$DSH_TRUSTED_HOSTS" ]]; then
          warn "Plugin Hub 已安装但反代 Origin patch 未生效；域名访问时安装/卸载/保存设置可能返回 403 untrusted origin。"
          warn "可执行 dshd restart 让 entrypoint 重新应用 patch；若仍失败请检查容器日志。"
        fi

        hub_source="$hub_root/src/client/logic/failures.ts"
        hub_client="$hub_root/client/client.js"
        if docker_cmd exec "$DSH_NAME" test -f "$hub_client" 2>/dev/null; then
          if docker_cmd exec "$DSH_NAME" grep -Fq 'Minimum release age|untrusted origin' "$hub_client" 2>/dev/null; then
            warn "Plugin Hub 浏览器 bundle 仍会把 bare 'untrusted origin' 误判为 pnpmPolicy；新版 runtime patch 应直接修复 client/client.js。"
          elif docker_cmd exec "$DSH_NAME" grep -Fq 'ERR_PNPM_UNTRUSTED_ORIGIN' "$hub_client" 2>/dev/null; then
            ok "Plugin Hub 浏览器失败分类 patch 已生效"
          fi
        elif [[ -n "$DSH_TRUSTED_HOSTS" ]]; then
          warn "未找到 Plugin Hub 浏览器 bundle，无法确认前端失败分类 patch。"
        fi

        if docker_cmd exec "$DSH_NAME" test -f "$hub_source" 2>/dev/null \
          && docker_cmd exec "$DSH_NAME" grep -Fq 'Minimum release age|untrusted origin' "$hub_source" 2>/dev/null; then
          warn "Plugin Hub TypeScript 源码仍含旧 pnpmPolicy 误分类规则；runtime bundle 检查结果优先。"
        fi

        # 做一次无副作用的空 settings POST，验证实际 Origin/Host 门禁，而不是只看补丁字符串。
        # 这能捕获“代码看似已 patch，但 Trusted Hosts 实际被错误解析”的假阳性。
        hub_token="$(docker_cmd logs "$DSH_NAME" 2>&1 | grep -oE 'token=[A-Za-z0-9_-]+' | tail -1 | cut -d= -f2 || true)"
        hub_host="$(first_trusted_host 2>/dev/null || true)"
        if [[ -n "$hub_token" && -n "$hub_host" && "$hub_host" != *"://"* ]] && command -v curl >/dev/null 2>&1; then
          hub_post_code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 3 --max-time 5 \
            -X POST "http://127.0.0.1:${DSH_PORT}/dsh-plugin-hub/settings?token=${hub_token}" \
            -H "Host: ${hub_host}" -H "Origin: https://${hub_host}" \
            -H 'Content-Type: application/json' --data '{}' 2>/dev/null || true)"
          if [[ "$hub_post_code" == "200" ]]; then
            ok "Plugin Hub Trusted Host POST 实测通过: HTTP 200"
          else
            warn "Plugin Hub Trusted Host POST 实测失败: HTTP ${hub_post_code:-000}；域名安装操作仍可能返回 untrusted origin。"
          fi
        fi
      fi

      if [[ "$DSH_DOCKER_ACCESS" == "true" ]]; then
        sensitive_env_count="$(docker_cmd inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$DSH_NAME" 2>/dev/null \
          | awk -F= 'toupper($1) ~ /(KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL)/ {n++} END {print n+0}')"
        if [[ "$sensitive_env_count" =~ ^[0-9]+$ ]] && (( sensitive_env_count > 0 )); then
          warn "Docker 管理模式已开启，且容器中检测到 $sensitive_env_count 个敏感命名环境变量。"
          warn "Docker Socket 可通过 docker inspect 读取容器环境；DSH 的子进程密钥过滤不构成秘密隔离。"
        else
          warn "Docker 管理模式已开启：Docker Socket 基本等价于宿主机 root 权限。"
        fi
      fi
    fi

    local host_mem_total_kb host_mem_available_kb host_swap_total_kb host_swap_free_kb host_swap_used_kb runtime_mem_limit
    host_mem_total_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    host_mem_available_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    host_swap_total_kb="$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    host_swap_free_kb="$(awk '/^SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    [[ "$host_mem_total_kb" =~ ^[0-9]+$ ]] || host_mem_total_kb=0
    [[ "$host_mem_available_kb" =~ ^[0-9]+$ ]] || host_mem_available_kb=0
    [[ "$host_swap_total_kb" =~ ^[0-9]+$ ]] || host_swap_total_kb=0
    [[ "$host_swap_free_kb" =~ ^[0-9]+$ ]] || host_swap_free_kb=0
    host_swap_used_kb=$((host_swap_total_kb - host_swap_free_kb))
    if (( host_mem_total_kb > 0 )); then
      info "宿主资源: RAM $((host_mem_total_kb / 1024)) MiB，总可用约 $((host_mem_available_kb / 1024)) MiB；Swap 已用 $((host_swap_used_kb / 1024)) / $((host_swap_total_kb / 1024)) MiB"
    fi
    runtime_mem_limit="$(container_exists && docker_cmd inspect -f '{{.HostConfig.Memory}}' "$DSH_NAME" 2>/dev/null || echo 0)"
    [[ "$runtime_mem_limit" =~ ^[0-9]+$ ]] || runtime_mem_limit=0
    if (( host_mem_total_kb > 0 && host_mem_total_kb <= 6291456 && runtime_mem_limit == 0 )); then
      warn "宿主机内存不超过 6 GiB，且 DSH 当前无内存上限；Chromium/大型构建可能挤压其他服务。可在 dshd config 设置 DSH_MEMORY_LIMIT。"
    fi

    if container_running && command -v curl >/dev/null 2>&1; then
      local code
      code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 3 --max-time 5 "http://127.0.0.1:${DSH_PORT}/" 2>/dev/null || true)"
      if [[ "$code" =~ ^(200|302|303|401)$ ]]; then ok "Web 端口响应正常: HTTP $code"; else warn "Web 端口响应异常: HTTP ${code:-000}"; fi
    fi
    docker_cmd system df 2>/dev/null || true
  fi
}
cmd_uninstall() {
  load_config; ensure_docker
  heading "卸载 dsh"
  if dashboard_container_exists 2>/dev/null; then
    docker_cmd rm -f "$(dashboard_container_name)" >/dev/null || true
    ok "Research Dashboard sidecar 已删除"
  fi
  if container_exists && confirm "删除容器 $DSH_NAME？" Y; then docker_cmd rm -f "$DSH_NAME" >/dev/null; ok "容器已删除"; fi
  if ! container_exists; then
    proxy_remove_sidecar
    proxy_remove_network
    ok "sing-box sidecar / 代理网络已清理"
  fi

  if [[ "$DSH_STORAGE_MODE" == "volume" ]]; then
    if docker_cmd volume inspect "$DSH_VOLUME" >/dev/null 2>&1 && confirm "删除数据卷 $DSH_VOLUME？这会删除会话和凭据。" N; then
      docker_cmd volume rm "$DSH_VOLUME" >/dev/null
      ok "数据卷已删除"
    fi
  elif [[ -d "$DSH_DATA_DIR" ]]; then
    if confirm "删除数据目录 $DSH_DATA_DIR？这会删除会话、凭据和插件数据。" N; then
      case "$DSH_DATA_DIR" in
        /|/root|/home|/opt|/usr|/var) die "拒绝删除高风险目录: $DSH_DATA_DIR" ;;
      esac
      as_root rm -rf -- "$DSH_DATA_DIR"
      ok "数据目录已删除"
    fi
  fi

  if [[ -d "$DSH_WORKSPACE" ]] && confirm "删除工作区 $DSH_WORKSPACE？" N; then as_root rm -rf "$DSH_WORKSPACE"; ok "工作区已删除"; fi
  if confirm "删除 dshd 配置目录 $STATE_DIR？" N; then rm -rf "$STATE_DIR"; ok "配置目录已删除"; fi
  if [[ -e /usr/local/bin/dshd ]] && confirm "删除 dshd 命令本身？" N; then as_root rm -f /usr/local/bin/dshd; ok "dshd 已删除"; fi
}

