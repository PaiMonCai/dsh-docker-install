  调整失败退避:   export DSHD_SELF_UPDATE_RETRY_DELAY=600
EOF
}


# 仅在彩色终端使用 ANSI，重定向/NO_COLOR/TERM=dumb 保持纯文本。
menu_colors_enabled() {
  [[ -t 1 && -z "${NO_COLOR:-}" && "${CLICOLOR:-1}" != "0" && "${TERM:-}" != "dumb" ]]
}

# 在不改变双列对齐的前提下突出显示快捷键。
menu_option_line() {
  local remaining="$1" cyan="$2" red="$3" muted="$4" reset="$5"
  local token prefix color danger=0
  while [[ "$remaining" =~ \[[0-9][0-9]\]|\[\ 0\] ]]; do
    token="${BASH_REMATCH[0]}"
    prefix="${remaining%%"$token"*}"
    remaining="${remaining#*"$token"}"
    case "$token" in
      '[20]') color="$red"; danger=1 ;;
      '[ 0]') color="$muted" ;;
      *) color="$cyan" ;;
    esac
    printf '%s%s%s%s' "$prefix" "$color" "$token" "$reset"
  done
  if (( danger )); then
    printf '%s%s%s\n' "$red" "$remaining" "$reset"
  else
    printf '%s\n' "$remaining"
  fi
}


