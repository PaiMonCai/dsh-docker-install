cmd_container_env() {
  local action="${1:-help}" name="${2:-}" value="${3-}" tmp line key
  load_config

  case "$action" in
    path)
      printf '%s\n' "$CONTAINER_ENV_FILE"
      ;;
    show|list)
      if [[ ! -s "$CONTAINER_ENV_FILE" ]]; then
        info "尚未配置自定义容器环境变量。"
        return
      fi
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" != \#* ]] || continue
        key="${line%%=*}"
        if [[ "${key^^}" =~ (KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL) ]]; then
          printf '%s=******\n' "$key"
        else
          printf '%s\n' "$line"
        fi
      done <"$CONTAINER_ENV_FILE"
      ;;
    set)
      [[ -n "$name" ]] || die "用法: dshd env set NAME VALUE"
      validate_env_name "$name" || die "环境变量名不合法: $name"
      ensure_container_env_file
      tmp="$(mktemp)"
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "${line%%=*}" == "$name" ]] || printf '%s\n' "$line"
      done <"$CONTAINER_ENV_FILE" >"$tmp"
      printf '%s=%s\n' "$name" "$value" >>"$tmp"
      chmod 600 "$tmp"
      mv "$tmp" "$CONTAINER_ENV_FILE"
      container_env_changed
      ;;
    remove|unset|delete)
      [[ -n "$name" ]] || die "用法: dshd env remove NAME"
      validate_env_name "$name" || die "环境变量名不合法: $name"
      ensure_container_env_file
      tmp="$(mktemp)"
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "${line%%=*}" == "$name" ]] || printf '%s\n' "$line"
      done <"$CONTAINER_ENV_FILE" >"$tmp"
      chmod 600 "$tmp"
      mv "$tmp" "$CONTAINER_ENV_FILE"
      container_env_changed
      ;;
    edit)
      ensure_container_env_file
      "${EDITOR:-vi}" "$CONTAINER_ENV_FILE"
      chmod 600 "$CONTAINER_ENV_FILE"
      container_env_changed
      ;;
    help|-h|--help)
      cat <<EOF
用法:
  dshd env                 查看容器开发环境版本
  dshd env show            查看自定义容器环境变量（敏感值隐藏）
  dshd env set NAME VALUE  添加或更新容器环境变量
  dshd env remove NAME     删除容器环境变量
  dshd env edit            编辑独立的 container.env
  dshd env show            查看自定义容器环境变量（敏感值会隐藏）
  dshd env set NAME VALUE  添加或更新变量
  dshd env remove NAME     删除变量
  dshd env edit            使用 EDITOR 编辑环境变量文件
  dshd env path            显示环境变量文件路径

配置保存在: $CONTAINER_ENV_FILE
修改后需要重建容器才能生效。
EOF
      ;;
    *)
      die "未知 env 子命令: $action"
      ;;
  esac
}

