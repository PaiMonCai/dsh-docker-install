#!/usr/bin/env bash
# dshd - DeepSeek Harness Docker 管理器
# 项目: https://github.com/PaiMonCai/dsh-docker-install
set -Eeuo pipefail

DSHD_VERSION="0.12.1"
WEB_WORKER_SHA256="4714ac2aa7cad75e29249642a705cdd83a6a5197721f7d60b701271a9e0251c7"
# Defaults also apply when dshd is sourced by existing shell tests/tools without load_config().
DSH_SEARCH_ENABLED="${DSH_SEARCH_ENABLED:-false}"
DSH_SEARCH_BRAVE_ENABLED="${DSH_SEARCH_BRAVE_ENABLED:-false}"
DSH_SEARCH_CACHE_ENABLED="${DSH_SEARCH_CACHE_ENABLED:-true}"
DSH_SEARCH_IMAGE="${DSH_SEARCH_IMAGE:-searxng/searxng:latest}"
DSH_SEARCH_BRAVE_DAILY_LIMIT="${DSH_SEARCH_BRAVE_DAILY_LIMIT:-50}"
REPO="PaiMonCai/dsh-docker-install"
RAW_BASE="https://raw.githubusercontent.com/${REPO}/main"
CDN_BASE="https://cdn.jsdelivr.net/gh/${REPO}@main"
# 自身脚本路径；通过管道（curl | bash）执行时为空，此时跳过自更新。
SELF_PATH="${BASH_SOURCE[0]:-}"
# 自更新拉取失败后的退避秒数，避免网络不通时每次启动都卡住。
SELF_UPDATE_RETRY_DELAY="${DSHD_SELF_UPDATE_RETRY_DELAY:-300}"
