    -u DSHD_MOUNTS_FILE -u DSHD_BACKUP_DIR -u DSHD_PROXY_DIR \
    -u DSHD_REVERSE_MODE -u DSHD_INSTANCE_EDITION \
    "DSHD_STATE_DIR=$directory" "DSHD_INSTANCE_ID=$id" \
    "DSHD_INSTANCE_ROOT_STATE_DIR=$INSTANCE_ROOT_STATE_DIR" \
    bash "$self" "${@:-menu}"
}
instance_port_reserved() {
  local port="$1" file
  for file in "$INSTANCE_ROOT_STATE_DIR/config.env" "$INSTANCE_ROOT_STATE_DIR-reverse/config.env" "$INSTANCE_ROOT_STATE_DIR"/instances/*/config.env; do
    [[ -f "$file" ]] || continue
    grep -Fxq "DSH_PORT=$port" "$file" && return 0
  done
  return 1
}
instance_next_port() {
  local port
  for port in $(seq 3082 3199); do
    if ! instance_port_reserved "$port" && ! port_in_use "$port"; then
      printf '%s' "$port"
      return 0
    fi
  done
  die "3082-3199 内没有空闲端口，请释放端口后重试。"
}
instance_add() {
  local id="${1:-}" edition="${2:-standard}" image pack=none port self
  instance_validate_id "$id" || die "实例名称必须为小写字母开头的 1-32 位字母、数字或连字符，且不能为 default。"
  [[ ! -e "$(instance_config_dir "$id")" ]] || die "实例 $id 已存在，请通过 dshd -i $id 管理。"
  if [[ "$id" == reverse && -f "$INSTANCE_ROOT_STATE_DIR-reverse/config.env" ]]; then
    die "已有历史 Reverse 实例，请使用 dshd reverse 管理。"
  fi
  case "$edition" in
    standard) image="$DEFAULT_IMAGE" ;;
    research) image="$RESEARCH_IMAGE" ;;
    research-economics) image="$RESEARCH_ECONOMICS_IMAGE"; pack=economics ;;
    reverse) image="$REVERSE_IMAGE" ;;
    *) die "未知 Edition: $edition（支持 standard/research/research-economics/reverse）" ;;
  esac
  local flavor="$edition"
  [[ "$edition" == research-economics ]] && edition=research
  ensure_docker
  if docker_cmd ps -a --format '{{.Names}}' | grep -Fxq "dsh-$id"; then
    die "容器 dsh-$id 已存在；请先核实其所有权，不允许覆盖。"
  fi
  port="$(instance_next_port)"
  self="${BASH_SOURCE[0]}"
  [[ -f "$self" ]] || die "无法定位 dshd 可执行文件。"
  info "创建实例 $id（$flavor），使用容器 dsh-$id、建议端口 $port"
  env -u DSHD_LIB_ONLY -u DSHD_CONFIG_FILE -u DSHD_CONTAINER_ENV_FILE \
    -u DSHD_MOUNTS_FILE -u DSHD_BACKUP_DIR -u DSHD_PROXY_DIR \
    "DSHD_STATE_DIR=$(instance_config_dir "$id")" \
    "DSHD_INSTANCE_ROOT_STATE_DIR=$INSTANCE_ROOT_STATE_DIR" \
    "DSHD_INSTANCE_ID=$id" "DSHD_INSTANCE_EDITION=$edition" \
    "DSHD_REVERSE_MODE=$([[ "$edition" == reverse ]] && echo 1 || echo 0)" \
    "DSH_NAME=dsh-$id" "DSH_PORT=$port" \
    "DSH_RESEARCH_DASHBOARD_PORT=$((port + 6000))" \
    "DSH_EDITION=$edition" "DSH_RESEARCH_PACK=$pack" "DSH_IMAGE=$image" \
    "DSH_DOCKER_ACCESS=false" bash "$self" install
}
instance_show_one() {
  local id="$1" cfg="$2" record name edition port state
  [[ -f "$cfg" ]] || return 0
  record="$(
    unset DSH_NAME DSH_EDITION DSH_PORT
    # Each config is already sourced by its individual manager.
    source "$cfg"
    printf '%s|%s|%s' "${DSH_NAME:-unknown}" "${DSH_EDITION:-standard}" "${DSH_PORT:-?}"
  )" || { warn "无法读取 $id 的配置"; return 1; }
  IFS='|' read -r name edition port <<<"$record"
