# Reverse is an independent managed instance, never a conversion of Standard.
cmd_reverse_instance() {
  local action="${1:-status}" self="${BASH_SOURCE[0]}" next_state
  shift || true
  [[ -f "$self" ]] || die "无法定位当前 dshd 文件；请先安装 dshd 命令。"
  next_state="${DSHD_REVERSE_STATE_DIR:-${STATE_DIR}-reverse}"
  [[ "$next_state" != "$STATE_DIR" ]] || die "Reverse 配置目录不可与 Standard 相同。"
  if [[ "$action" != "install" ]]; then
    [[ -f "$next_state/config.env" ]] || die "Reverse 实例尚未安装：请先执行 dshd reverse install。"
    grep -Fxq "DSH_EDITION=reverse" "$next_state/config.env" \
      || die "Reverse 配置标识不正确；拒绝管理可能属于 Standard 的容器。"
  fi
  local defaults=()
  if [[ "$action" == "install" ]]; then
    defaults+=( "DSH_EDITION=reverse" "DSHD_REVERSE_MODE=1"
      "DSH_IMAGE=${DSH_IMAGE_OVERRIDE_REVERSE:-$REVERSE_IMAGE}"
      "DSH_NAME=${DSH_REVERSE_NAME:-dsh-reverse}"
      "DSH_PORT=${DSH_REVERSE_PORT:-3081}"
      "DSH_WORKSPACE=${DSH_REVERSE_WORKSPACE:-$BASE_WORKSPACE/reverse}"
      "DSH_STORAGE_MODE=bind"
      "DSH_DATA_DIR=${DSH_REVERSE_DATA_DIR:-$BASE_WORKSPACE/reverse-data}"
      "DSH_VOLUME=${DSH_REVERSE_VOLUME:-dsh-reverse-home}"
      "DSH_DOCKER_ACCESS=false" )
  fi
  env -u DSHD_LIB_ONLY -u DSHD_CONFIG_FILE -u DSHD_CONTAINER_ENV_FILE \
    -u DSHD_MOUNTS_FILE -u DSHD_BACKUP_DIR -u DSHD_PROXY_DIR \
    "DSHD_STATE_DIR=$next_state" "${defaults[@]}" bash "$self" "$action" "$@"
}

