else
  STATE_DIR="${DSHD_STATE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dshd}"
  BASE_WORKSPACE="$HOME/dsh/workspaces"
  DEFAULT_WORKSPACE="$HOME/dsh/workspace"
  DEFAULT_DATA_DIR="$HOME/dsh/data"
fi
# Named instances use their own defaults. The legacy default and Reverse paths
# retain their historical layout for zero-migration upgrades.
if [[ -n "${DSHD_INSTANCE_ID:-}" ]]; then
  [[ "$DSHD_INSTANCE_ID" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || {
