  [[ "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]] && [[ "$1" != default ]]
}
instance_config_dir() {
  printf '%s/instances/%s' "$INSTANCE_ROOT_STATE_DIR" "$1"
