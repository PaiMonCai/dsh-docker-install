menu() {
  load_config
  while true; do
    clear 2>/dev/null || true
    printf '%sDeepSeek Harness Docker Manager%s  v%s\n' "$C_CYAN" "$C_RESET" "$DSHD_VERSION"
    printf '容器: %-16s 状态: %-12s 健康: %-10s Edition: %-8s Pack: %-10s Docker管理: %s\n' \
      "$DSH_NAME" "$(container_state 2>/dev/null || echo unknown)" "$(health_state 2>/dev/null || echo unknown)" "$DSH_EDITION" "$DSH_RESEARCH_PACK" "$DSH_DOCKER_ACCESS"
    cat <<'EOF'

  1) 安装 / 初始化
  2) 查看状态
  3) 启动
  4) 停止
  5) 重启
  6) 查看实时日志
  7) 更新镜像并重建
  8) 修改完整配置
  9) DeepSeek API / Base URL 配置
 10) 快捷管理 Trusted Hosts
 11) Docker 项目管理权限
 12) 查看容器开发环境
 13) 显示首次访问 Token URL
 14) 进入容器 Shell
 15) 备份数据
 16) 恢复数据
 17) 环境诊断
 18) 按当前配置重建
 19) 检查更新 dshd 自身
 20) 卸载
 21) Standard / Research 版本切换
 22) Research Pack 切换
 23) 查看持久化存储
 24) Research Dashboard
 25) Whale Widget 远程写权限
 26) 自定义持久化挂载
 27) 国际网络 / sing-box

  0) 退出
EOF
    local choice=""
    read -r -p $'\n请选择: ' choice || return
    printf '\n'
    case "$choice" in
      1) cmd_install ;;
      2) cmd_status ;;
      3) cmd_start ;;
      4) cmd_stop ;;
      5) cmd_restart ;;
      6) cmd_logs ;;
      7) cmd_update ;;
      8) cmd_config ;;
      9) cmd_api ;;
      10) cmd_hosts ;;
      11) cmd_docker_access ;;
      12) cmd_env ;;
      13) cmd_token ;;
      14) cmd_shell ;;
      15) cmd_backup ;;
      16) cmd_restore ;;
      17) cmd_doctor ;;
      18) cmd_recreate ;;
      19) cmd_self_update ;;
      20) cmd_uninstall ;;
      21) cmd_edition_menu ;;
      22) cmd_research_pack_menu ;;
      23) cmd_storage show ;;
      24) cmd_dashboard status ;;
      25) cmd_admin_hosts ;;
      26) cmd_mounts_menu ;;
      27) cmd_proxy ;;
      0) return ;;
      *) warn "无效选项" ;;
    esac
    if [[ "$choice" != "6" && "$choice" != "14" ]]; then
      read -r -p $'\n按 Enter 返回菜单...' _ || true
    fi
    load_config
  done
}

main() {
  local cmd="${1:-menu}"

  # 除 help/version 这类纯本地命令外，每次调用都先检查脚本自身是否有新版本。
  case "$cmd" in
    help|-h|--help|version|-v|--version) ;;
    *) self_update auto "$@" ;;
  esac

  case "$cmd" in
    menu) menu ;;
    install) cmd_install ;;
    status) cmd_status ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    logs) cmd_logs ;;
    update|upgrade) cmd_update ;;
    recreate) cmd_recreate ;;
    config) cmd_config ;;
    edition) shift; cmd_edition "${1:-show}" ;;
    research-pack|pack) shift; cmd_research_pack "${1:-show}" ;;
    api|provider) shift; cmd_api "$@" ;;
    hosts|trusted-hosts) shift; cmd_hosts "$@" ;;
    admin-hosts|whale-admin-hosts) shift; cmd_admin_hosts "$@" ;;
    docker|docker-access) shift; cmd_docker_access "$@" ;;
    proxy|egress|sing-box|singbox) shift; cmd_proxy "$@" ;;
    storage|data-storage) shift; cmd_storage "$@" ;;
    mounts|mount|persistent-mounts) shift; cmd_mounts "$@" ;;
    dashboard|research-dashboard) shift; cmd_dashboard "$@" ;;
    env|environment) shift; cmd_env "$@" ;;
    shell) cmd_shell ;;
    token|url) cmd_token ;;
    backup) cmd_backup ;;
    restore) shift; cmd_restore "${1:-}" ;;
    doctor|check) cmd_doctor ;;
    self-update|selfupdate) cmd_self_update ;;
    uninstall|remove) cmd_uninstall ;;
    version|-v|--version) printf 'dshd %s\n' "$DSHD_VERSION" ;;
    help|-h|--help) print_help ;;
    *) err "未知命令: $cmd"; print_help; exit 2 ;;
  esac
}

if [[ "${DSHD_LIB_ONLY:-0}" != "1" ]]; then
  main "$@"
fi
