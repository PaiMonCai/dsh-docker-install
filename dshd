PROXY_DIR="${DSHD_PROXY_DIR:-$STATE_DIR/proxy}"
PROXY_NODES_DIR="$PROXY_DIR/nodes"
PROXY_SUBSCRIPTIONS_DIR="$PROXY_DIR/subscriptions"
PROXY_CONFIG_FILE="$PROXY_DIR/config.json"
PROXY_RESULTS_FILE="$PROXY_DIR/last-test.tsv"
# Preserve the shared instance registry when navigating from a named menu.
if [[ -n "${DSHD_INSTANCE_ID:-}" && "$STATE_DIR" == */instances/"$DSHD_INSTANCE_ID" ]]; then
  INSTANCE_ROOT_STATE_DIR="${DSHD_INSTANCE_ROOT_STATE_DIR:-${STATE_DIR%/instances/$DSHD_INSTANCE_ID}}"
elif [[ "${DSHD_REVERSE_MODE:-0}" == "1" && "$STATE_DIR" == *-reverse ]]; then
  INSTANCE_ROOT_STATE_DIR="${DSHD_INSTANCE_ROOT_STATE_DIR:-${STATE_DIR%-reverse}}"
else
  INSTANCE_ROOT_STATE_DIR="${DSHD_INSTANCE_ROOT_STATE_DIR:-$STATE_DIR}"
fi

C_RESET=$'\033[0m'
C_BLUE=$'\033[1;34m'
C_GREEN=$'\033[1;32m'
C_YELLOW=$'\033[1;33m'
C_RED=$'\033[1;31m'
C_CYAN=$'\033[1;36m'

info()    { printf '%s==>%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()      { printf '%s[✓]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn()    { printf '%s[!]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()     { printf '%s[x]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
# die: 放弃“当前这一次操作”。在交互菜单里只结束当前动作并回到菜单（见 run_action），
# 在 CLI 路径上结束进程。exit 在任何上下文（含 if/while 条件）都生效，因此它是默认选择。
die()     { err "$*"; exit 1; }
# 需要把失败“返回给调用方”时（例如 load_config 的校验、prompt 的取消），
# 就地使用 `{ err "…"; return 1; }`：return 只跳出当前函数，语义更可控。
heading() { printf '\n%s%s%s\n' "$C_CYAN" "$*" "$C_RESET"; }

# 交互判定只看标准输入：stdout 被重定向（例如 dshd | tee log）时依然能读键盘。
is_tty() { [[ -t 0 ]]; }

# ---------- 菜单交互框架 ----------
# 交互菜单中的每个动作都在子 shell 里带 set -e 执行：
# 任何失败（包括子命令内部的 die）只终止这一次操作，菜单继续可用。
# 非交互 CLI 路径不经过这里，保持原来的“失败即退出”语义。
run_action() {
  local rc=0
  ( set -e; "$@" ) || rc=$?
  # 被 Ctrl-C 打断时已经由 on_menu_interrupt 提示过，不再重复报错。
  if (( rc == 130 || rc == 131 )); then
    return 0
  fi
  if (( rc != 0 )); then
    warn "本次操作未完成（退出码 $rc），已返回菜单。"
  fi
  return 0
}

# 菜单里 Ctrl-C / SIGQUIT 只取消当前操作，不再直接结束管理器。
# 非菜单（一次性 CLI 命令）仍保持“中断即退出”，避免留下半成品。
on_menu_interrupt() {
  printf '\n' >&2
  if [[ "${DSHD_MENU_ACTIVE:-0}" != "1" ]]; then
    err "已中断。"
    exit 130
  fi
  warn "已取消当前操作。"
}

menu_signal_guard() {
  trap 'on_menu_interrupt' INT
  trap 'on_menu_interrupt' QUIT
}

# 读取菜单选项的统一入口。
# 返回 0 = 已取得输入；1 = 输入结束（Ctrl-D，退出当前菜单）；2 = 被 Ctrl-C 打断（重绘当前菜单）。
menu_read() {
  local __var="$1" prompt="$2" _rc=0 _val=""
  read -r -p "$prompt" _val || _rc=$?
  printf '\n'
  if (( _rc == 0 )); then
    printf -v "$__var" '%s' "$_val"
    return 0
  fi
  (( _rc > 128 )) && return 2
  return 1
}

confirm() {
  local prompt="${1:-确认继续？}" default="${2:-N}" ans
  if ! is_tty; then
    [[ "${DSHD_WEB_CONFIRMED:-0}" == 1 ]] && return 0
    [[ "$default" =~ ^[Yy]$ ]]
    return
  fi
  if [[ "$default" =~ ^[Yy]$ ]]; then
    read -r -p "$prompt [Y/n] " ans || { printf '\n' >&2; warn "输入已结束，按“否”处理。"; return 1; }
    [[ -z "$ans" || "$ans" =~ ^[Yy]$ ]]
  else
    read -r -p "$prompt [y/N] " ans || { printf '\n' >&2; warn "输入已结束，按“否”处理。"; return 1; }
    [[ "$ans" =~ ^[Yy]$ ]]
  fi
}

prompt_value() {
  local __var="$1" prompt="$2" default="$3" value
  if is_tty; then
    if ! read -r -p "$prompt [$default]: " value; then
      # Ctrl-D / 输入流结束：沿用默认值，并在本次配置结束时放弃保存。
      printf '\n' >&2
      if [[ "${DSHD_INPUT_EOF:-0}" != "1" ]]; then
        DSHD_INPUT_EOF=1
        warn "输入已结束（EOF）：后续提示一律沿用当前值，本次修改不会被保存。"
      fi
      value=""
    fi
  else
    value=""
  fi
  printf -v "$__var" '%s' "${value:-$default}"
}

prompt_required() {
  local __var="$1" prompt="$2" value="${!1:-}"
  if ! is_tty; then
    [[ -n "$value" ]] || die "$prompt：非交互安装必须通过环境变量提供。"
    return 0
  fi
  while [[ -z "$value" ]]; do
    # 输入流结束时必须立刻退出，否则会在这里空转刷屏。
    if ! read -r -p "$prompt: " value; then
      printf '\n' >&2
      err "输入已结束（EOF），已取消本次操作。"
      return 1
    fi
    [[ -n "$value" ]] || warn "此项不能为空，请重新输入。"
  done
  printf -v "$__var" '%s' "$value"
}

# 需要“校验不过就重问”的字段统一走这里：回车沿用当前值，Ctrl-C / EOF 放弃本次操作。
prompt_validated() {
  local __var="$1" prompt="$2" current="$3" validator="$4" hint="$5" _pvv=""
  while true; do
    prompt_value _pvv "$prompt" "$current"
    if [[ "${DSHD_INPUT_EOF:-0}" == "1" ]]; then
      printf -v "$__var" '%s' "$_pvv"
      return 1
    fi
    if "$validator" "$_pvv"; then
      printf -v "$__var" '%s' "$_pvv"
      return 0
    fi
    warn "${hint:-输入不合法，请重新输入。}"
    current="$_pvv"
  done
}

validate_container_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

validate_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( 1 <= 10#$1 && 10#$1 <= 65535 ))
}

validate_docker_size() {
  [[ "$1" =~ ^[1-9][0-9]*([kKmMgG][bB]?)?$ ]]
}

is_absolute_path() { [[ "$1" == /* ]]; }

is_non_empty() { [[ -n "$1" ]]; }

docker_size_bytes() {
  local raw="${1,,}" number suffix factor=1
  [[ "$raw" =~ ^([1-9][0-9]*)([kmg]b?)?$ ]] || return 1
  number="${BASH_REMATCH[1]}"
  suffix="${BASH_REMATCH[2]:-}"
  case "$suffix" in
    k|kb) factor=1024 ;;
    m|mb) factor=$((1024 * 1024)) ;;
    g|gb) factor=$((1024 * 1024 * 1024)) ;;
  esac
  printf '%s' "$((number * factor))"
}

validate_timezone() {
  [[ "$1" =~ ^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$ ]]
}

port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"
  else
    return 1
  fi
}

as_root() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    die "此操作需要 root 权限；请使用 root 或安装 sudo。"
  fi
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR" "$BACKUP_DIR"
  chmod 700 "$STATE_DIR"
}

ensure_mounts_file() {
  ensure_state_dir
  if [[ ! -e "$MOUNTS_FILE" ]]; then
    : >"$MOUNTS_FILE"
    chmod 600 "$MOUNTS_FILE"
  fi
}

custom_mount_count() {
  if [[ ! -f "$MOUNTS_FILE" ]]; then
    printf '0'
    return 0
  fi
  awk -F'|' '
    /^[[:space:]]*($|#)/ { next }
    NF >= 2 { n++ }
    END { print n + 0 }
  ' "$MOUNTS_FILE"
}

validate_custom_mount() {
  local source="${1:-}" target="${2:-}" mode="${3:-rw}"
  MOUNT_VALIDATION_ERROR=""

  if [[ -z "$source" || "$source" != /* ]]; then
    MOUNT_VALIDATION_ERROR="宿主机源目录必须是绝对路径: ${source:-（空）}"
    return 1
  fi
  if [[ -z "$target" || "$target" != /* ]]; then
    MOUNT_VALIDATION_ERROR="容器目标目录必须是绝对路径: ${target:-（空）}"
    return 1
  fi
  if [[ "$source" == "/" ]]; then
    MOUNT_VALIDATION_ERROR="拒绝把宿主机根目录 / 作为自定义持久化源。"
    return 1
  fi
  if [[ "$source" == *'|'* || "$source" == *','* || "$source" == *$'\n'* ]]; then
    MOUNT_VALIDATION_ERROR="宿主机源目录不能包含 |、逗号或换行: $source"
    return 1
  fi
  if [[ "$target" == *'|'* || "$target" == *','* || "$target" == *$'\n'* ]]; then
    MOUNT_VALIDATION_ERROR="容器目标目录不能包含 |、逗号或换行: $target"
    return 1
  fi
  if [[ "$source" =~ (^|/)\.\.(/|$) ]]; then
    MOUNT_VALIDATION_ERROR="宿主机源目录不能包含 .. 路径段: $source"
    return 1
  fi
  if [[ "$target" =~ (^|/)\.\.(/|$) ]]; then
    MOUNT_VALIDATION_ERROR="容器目标目录不能包含 .. 路径段: $target"
    return 1
  fi
  case "$mode" in
    rw|ro) ;;
    *)
      MOUNT_VALIDATION_ERROR="挂载模式仅支持 rw 或 ro: $mode"
      return 1
      ;;
  esac
  case "$target" in
    /|/root|/root/.dsh|/root/.dsh/*|/workspace|/workspace/*|/var/run/docker.sock|/var/run/docker.sock/*|/run|/run/dsh-management|/run/dsh-management/*)
      MOUNT_VALIDATION_ERROR="该容器路径由 dshd 管理或风险过高，不能作为自定义挂载目标: $target"
      return 1
      ;;
  esac
  return 0
}

require_custom_mount() {
  validate_custom_mount "$@" || die "$MOUNT_VALIDATION_ERROR"
}

custom_mount_target_conflict() {
  local target="$1" source existing_target mode
  [[ -f "$MOUNTS_FILE" ]] || return 1
  while IFS='|' read -r source existing_target mode _; do
    [[ -n "$source" && "$source" != \#* ]] || continue
    if [[ "$target" == "$existing_target" || "$target" == "$existing_target/"* || "$existing_target" == "$target/"* ]]; then
      return 0
    fi
  done <"$MOUNTS_FILE"
  return 1
}

prepare_custom_mount_source() {
  local source="$1" target="$2"
  if [[ -e "$source" && ! -d "$source" ]]; then
    die "自定义持久化目前只支持目录，宿主机路径不是目录: $source"
  fi
  if [[ ! -d "$source" ]]; then
    if ! mkdir -p "$source" 2>/dev/null; then
      as_root mkdir -p "$source"
    fi
  fi
  if [[ "$target" == "/root/.ssh" ]]; then
    as_root chmod 700 "$source" 2>/dev/null || true
  fi
}

add_custom_mount_record() {
  local source="$1" target="$2" mode="${3:-rw}"
  require_custom_mount "$source" "$target" "$mode"
  ensure_mounts_file
  custom_mount_target_conflict "$target" && die "该目标路径与已有自定义挂载重叠: $target"
  printf '%s|%s|%s\n' "$source" "$target" "$mode" >>"$MOUNTS_FILE"
  chmod 600 "$MOUNTS_FILE"
}

remove_custom_mount_record() {
  local target="$1" tmp found=0 line source existing_target mode
  [[ -f "$MOUNTS_FILE" ]] || return 1
  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" || "$line" == \#* ]]; then
      printf '%s\n' "$line" >>"$tmp"
      continue
    fi
    IFS='|' read -r source existing_target mode _ <<<"$line"
    if [[ "$existing_target" == "$target" ]]; then
      found=1
      continue
    fi
    printf '%s\n' "$line" >>"$tmp"
  done <"$MOUNTS_FILE"
  if (( found == 0 )); then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$MOUNTS_FILE"
}

detect_docker_socket() {
  if [[ -S "${DSH_DOCKER_SOCKET:-}" ]]; then
    return 0
  fi
  if [[ -S /var/run/docker.sock ]]; then
    DSH_DOCKER_SOCKET=/var/run/docker.sock
  elif [[ -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/docker.sock" ]]; then
    DSH_DOCKER_SOCKET="${XDG_RUNTIME_DIR}/docker.sock"
  else
    DSH_DOCKER_SOCKET=/var/run/docker.sock
  fi
}

load_config() {
  local legacy_storage=false requested_volume="${DSH_VOLUME:-}" requested_data_dir="${DSH_DATA_DIR:-}"
  local requested_instance_id="${DSHD_INSTANCE_ID:-}"
  DSH_EDITION="${DSH_EDITION:-}"
  DSH_RESEARCH_PACK="${DSH_RESEARCH_PACK:-}"
  DSH_IMAGE="${DSH_IMAGE:-$DEFAULT_IMAGE}"
  DSH_NAME="${DSH_NAME:-$DEFAULT_NAME}"
  DSH_PORT="${DSH_PORT:-$DEFAULT_PORT}"
  DSH_BIND_ADDR="${DSH_BIND_ADDR:-$DEFAULT_BIND_ADDR}"
  DSH_RESEARCH_DASHBOARD_PORT="${DSH_RESEARCH_DASHBOARD_PORT:-$DEFAULT_RESEARCH_DASHBOARD_PORT}"
  DSH_WORKSPACE="${DSH_WORKSPACE:-$DEFAULT_WORKSPACE}"
  DSH_STORAGE_MODE="${DSH_STORAGE_MODE:-}"
  DSH_DATA_DIR="${DSH_DATA_DIR:-}"
  DSH_VOLUME="${DSH_VOLUME:-$DEFAULT_VOLUME}"
  DSH_SHM_SIZE="${DSH_SHM_SIZE:-$DEFAULT_SHM_SIZE}"
  DSH_TIMEZONE="${DSH_TIMEZONE:-$DEFAULT_TIMEZONE}"
  DSH_NPM_CACHE="${DSH_NPM_CACHE:-$DEFAULT_NPM_CACHE}"
  DSH_MEMORY_LIMIT="${DSH_MEMORY_LIMIT:-$DEFAULT_MEMORY_LIMIT}"
  DSH_MEMORY_SWAP="${DSH_MEMORY_SWAP:-$DEFAULT_MEMORY_SWAP}"
  DSH_TRUSTED_HOSTS="${DSH_TRUSTED_HOSTS:-}"
  DSHW_ADMIN_HOSTS="${DSHW_ADMIN_HOSTS:-}"
  DEEPSEEK_BASE_URL="${DEEPSEEK_BASE_URL:-}"
  DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-}"
  DSH_DOCKER_ACCESS="${DSH_DOCKER_ACCESS:-false}"
  DSH_DOCKER_SOCKET="${DSH_DOCKER_SOCKET:-}"
  DSH_PROXY_ENABLED="${DSH_PROXY_ENABLED:-false}"
  DSH_SEARCH_ENABLED="${DSH_SEARCH_ENABLED:-false}"
  DSH_SEARCH_BRAVE_ENABLED="${DSH_SEARCH_BRAVE_ENABLED:-false}"
  DSH_SEARCH_CACHE_ENABLED="${DSH_SEARCH_CACHE_ENABLED:-true}"
  DSH_SEARCH_IMAGE="${DSH_SEARCH_IMAGE:-searxng/searxng:latest}"
  DSH_SEARCH_BRAVE_DAILY_LIMIT="${DSH_SEARCH_BRAVE_DAILY_LIMIT:-50}"
  DSH_PROXY_NODE="${DSH_PROXY_NODE:-}"
  DSH_PROXY_IMAGE="${DSH_PROXY_IMAGE:-$DEFAULT_PROXY_IMAGE}"
  DSH_PROXY_PORT="${DSH_PROXY_PORT:-$DEFAULT_PROXY_PORT}"
  DSH_PROXY_NO_PROXY="${DSH_PROXY_NO_PROXY:-}"
  DSH_PROXY_FAILOVER_ENABLED="${DSH_PROXY_FAILOVER_ENABLED:-false}"
  DSH_PROXY_FAILOVER_URL="${DSH_PROXY_FAILOVER_URL:-$DEFAULT_PROXY_FAILOVER_URL}"
  DSH_PROXY_FAILOVER_INTERVAL="${DSH_PROXY_FAILOVER_INTERVAL:-$DEFAULT_PROXY_FAILOVER_INTERVAL}"
  DSH_PROXY_FAILOVER_TOLERANCE="${DSH_PROXY_FAILOVER_TOLERANCE:-$DEFAULT_PROXY_FAILOVER_TOLERANCE}"
  DSH_PROXY_FAILOVER_IDLE_TIMEOUT="${DSH_PROXY_FAILOVER_IDLE_TIMEOUT:-$DEFAULT_PROXY_FAILOVER_IDLE_TIMEOUT}"
  DSH_PROXY_FAILOVER_INTERRUPT="${DSH_PROXY_FAILOVER_INTERRUPT:-false}"

  if [[ -f "$CONFIG_FILE" ]]; then
    # config.env 仅由 dshd 自己写入，权限默认为 600。
    if ! grep -q '^DSH_STORAGE_MODE=' "$CONFIG_FILE" 2>/dev/null; then
      legacy_storage=true
    fi
    source "$CONFIG_FILE"
  fi
  if [[ -n "$requested_instance_id" && "${DSHD_INSTANCE_ID:-}" != "$requested_instance_id" ]]; then
    die "实例配置标识不匹配：$CONFIG_FILE（期待 $requested_instance_id）"
  fi

  # 兼容旧安装：历史 config.env 只有 DSH_VOLUME，没有存储模式。
  # 此时继续使用 named volume，不做静默迁移。
  if [[ -z "$DSH_STORAGE_MODE" ]]; then
    if [[ "$legacy_storage" == "true" || ( -n "$requested_volume" && -z "$requested_data_dir" ) ]]; then
      DSH_STORAGE_MODE="volume"
    else
      DSH_STORAGE_MODE="$DEFAULT_STORAGE_MODE"
    fi
  fi
  [[ -n "$DSH_DATA_DIR" ]] || DSH_DATA_DIR="$DEFAULT_DATA_DIR"
  [[ -n "$DSH_PROXY_NO_PROXY" ]] || DSH_PROXY_NO_PROXY="localhost,127.0.0.1,::1,host.docker.internal,${DSH_NAME},dsh-proxy"
  case "$DSH_STORAGE_MODE" in
    bind)
      [[ "$DSH_DATA_DIR" == /* ]] || die "DSH_DATA_DIR 必须是绝对路径: $DSH_DATA_DIR"
      ;;
    volume)
      [[ -n "$DSH_VOLUME" ]] || die "DSH_VOLUME 不能为空。"
      ;;
    *)
      die "未知 DSH_STORAGE_MODE=$DSH_STORAGE_MODE（仅支持 bind/volume）。"
      ;;
  esac

  # 兼容旧配置：没有 DSH_EDITION / DSH_RESEARCH_PACK 时根据镜像推断。
  if [[ -z "$DSH_EDITION" ]]; then
    case "$DSH_IMAGE" in
      "$RESEARCH_IMAGE"|"$RESEARCH_MIRROR_IMAGE"|"$RESEARCH_ECONOMICS_IMAGE"|"$RESEARCH_ECONOMICS_MIRROR_IMAGE"|*:research|*:research-*) DSH_EDITION="research" ;;
      "$REVERSE_IMAGE"|"$REVERSE_MIRROR_IMAGE"|*:reverse|*:reverse-*) DSH_EDITION="reverse" ;;
      *) DSH_EDITION="standard" ;;
    esac
  fi
  if [[ -z "$DSH_RESEARCH_PACK" ]]; then
    case "$DSH_IMAGE" in
      "$RESEARCH_ECONOMICS_IMAGE"|"$RESEARCH_ECONOMICS_MIRROR_IMAGE"|*:research-economics|*:research-economics-*) DSH_RESEARCH_PACK="economics" ;;
      *) DSH_RESEARCH_PACK="none" ;;
    esac
  fi

  validate_port "$DSH_RESEARCH_DASHBOARD_PORT" \
    || die "无效 DSH_RESEARCH_DASHBOARD_PORT=$DSH_RESEARCH_DASHBOARD_PORT"
  validate_port "$DSH_PROXY_PORT" || die "无效 DSH_PROXY_PORT=$DSH_PROXY_PORT"
  [[ "$DSH_SEARCH_BRAVE_DAILY_LIMIT" =~ ^[0-9]+$ ]] || die "无效 Brave 每日请求上限"
  [[ "$DSH_SEARCH_ENABLED" == "true" || "$DSH_SEARCH_ENABLED" == "false" ]] || die "DSH_SEARCH_ENABLED 必须 true/false"
  [[ "$DSH_SEARCH_BRAVE_ENABLED" == "true" || "$DSH_SEARCH_BRAVE_ENABLED" == "false" ]] || die "DSH_SEARCH_BRAVE_ENABLED 必须 true/false"
  [[ "$DSH_SEARCH_CACHE_ENABLED" == "true" || "$DSH_SEARCH_CACHE_ENABLED" == "false" ]] || die "DSH_SEARCH_CACHE_ENABLED 必须 true/false"
  [[ "$DSH_PROXY_ENABLED" == "true" || "$DSH_PROXY_ENABLED" == "false" ]] \
    || die "无效 DSH_PROXY_ENABLED=$DSH_PROXY_ENABLED（仅支持 true/false）。"
  [[ "$DSH_PROXY_FAILOVER_ENABLED" == "true" || "$DSH_PROXY_FAILOVER_ENABLED" == "false" ]] \
    || die "无效 DSH_PROXY_FAILOVER_ENABLED=$DSH_PROXY_FAILOVER_ENABLED（仅支持 true/false）。"
  [[ "$DSH_PROXY_FAILOVER_INTERRUPT" == "true" || "$DSH_PROXY_FAILOVER_INTERRUPT" == "false" ]] \
    || die "无效 DSH_PROXY_FAILOVER_INTERRUPT=$DSH_PROXY_FAILOVER_INTERRUPT（仅支持 true/false）。"
  [[ "$DSH_PROXY_FAILOVER_TOLERANCE" =~ ^[0-9]+$ ]] \
    || die "无效 DSH_PROXY_FAILOVER_TOLERANCE=$DSH_PROXY_FAILOVER_TOLERANCE（必须为非负整数毫秒）。"
  [[ "$DSH_EDITION" == "standard" || "$DSH_EDITION" == "research" || "$DSH_EDITION" == "reverse" ]] \
    || die "未知 DSH_EDITION=$DSH_EDITION（仅支持 standard/research/reverse）。"
  [[ "$DSH_RESEARCH_PACK" == "none" || "$DSH_RESEARCH_PACK" == "economics" ]] \
    || die "未知 DSH_RESEARCH_PACK=$DSH_RESEARCH_PACK（仅支持 none/economics）。"
  if [[ "$DSH_EDITION" != "research" ]]; then
    DSH_RESEARCH_PACK="none"
  fi

  detect_docker_socket
}

# 菜单/交互入口用它读配置：配置损坏时提供“备份并重置”，避免整个菜单打不开。
# load_config 内部用 die 报告非法配置，所以先放进子 shell 里试探，父进程不受影响。
load_config_guarded() {
  if ( load_config ) >/dev/null 2>&1; then
    load_config
    return 0
  fi
  if [[ ! -f "$CONFIG_FILE" ]]; then
    load_config
    return $?
  fi
  err "配置文件内容无效: $CONFIG_FILE"
  info "在子 shell 中重新校验，具体原因："
  ( load_config ) >/dev/null || true
  if ! is_tty; then
    warn "请手工修复该文件后重试（容器与数据未受影响）。"
    return 1
  fi
  warn "容器、持久化数据和工作区都不会被删除；重置后可在菜单里重新生成配置。"
  if ! confirm "备份该文件并重置为默认配置？" N; then
    warn "已保留原配置；请修复 $CONFIG_FILE 后重试。"
    return 1
  fi
  local backup="${CONFIG_FILE}.invalid.$(date +%Y%m%d-%H%M%S)"
  if ! cp -p "$CONFIG_FILE" "$backup" 2>/dev/null; then
    die "备份失败，未改动配置: $backup"
  fi
  rm -f "$CONFIG_FILE" || die "无法删除损坏的配置文件: $CONFIG_FILE"
  ok "原配置已备份到 $backup"
  load_config
}

