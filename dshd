menu() {
  load_config
  while true; do
    clear 2>/dev/null || true
    printf '%sDeepSeek Harness Docker Manager%s  v%s\n' "$C_CYAN" "$C_RESET" "$DSHD_VERSION"
    printf '容器: %-16s 状态: %-12s 健康: %-10s Docker管理: %s\n' \
      "$DSH_NAME" "$(container_state 2>/dev/null || echo unknown)" "$(health_state 2>/dev/null || echo unknown)" "$DSH_DOCKER_ACCESS"
    cat <<'EOF'

  1) 安装 / 初始化
  2) 查看状态
  3) 启动
  4) 停止
  5) 重启
  6) 查看实时日志
  7) 更新镜像并重建
  8) 修改完整配置
  9) 快捷管理 Trusted Hosts
 10) Docker 项目管理权限
 11) 查看容器开发环境
 12) 显示首次访问 Token URL
 13) 进入容器 Shell
 14) 备份数据
 15) 恢复数据
 16) 环境诊断
 17) 按当前配置重建
 18) 卸载

  0) 退出
EOF
    local choice=""
    read -r -p $'\n请选择: ' choice || return
    printf '\n'
    case "$choice" in
      1) cmd_install ;;
      2) cmd_status ;;
      3) cmd_start ;;
      4) cmd_stop ;;
      5) cmd_restart ;;
      6) cmd_logs ;;
      7) cmd_update ;;
      8) cmd_config ;;
      9) cmd_hosts ;;
      10) cmd_docker_access ;;
      11) cmd_env ;;
      12) cmd_token ;;
      13) cmd_shell ;;
      14) cmd_backup ;;
      15) cmd_restore ;;
      16) cmd_doctor ;;
      17) cmd_recreate ;;
      18) cmd_uninstall ;;
      0) return ;;
      *) warn "无效选项" ;;
    esac
    if [[ "$choice" != "6" && "$choice" != "13" ]]; then
      read -r -p $'\n按 Enter 返回菜单...' _ || true
    fi
    load_config
  done
}

main() {
  local cmd="${1:-menu}"
  case "$cmd" in
    menu) menu ;;
    install) cmd_install ;;
    status) cmd_status ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    logs) cmd_logs ;;
    update|upgrade) cmd_update ;;
    recreate) cmd_recreate ;;
    config) cmd_config ;;
    hosts|trusted-hosts) shift; cmd_hosts "$@" ;;
    docker|docker-access) shift; cmd_docker_access "$@" ;;
    env|environment) cmd_env ;;
    shell) cmd_shell ;;
    token|url) cmd_token ;;
    backup) cmd_backup ;;
    restore) shift; cmd_restore "${1:-}" ;;
    doctor|check) cmd_doctor ;;
    uninstall|remove) cmd_uninstall ;;
    version|-v|--version) printf 'dshd %s\n' "$DSHD_VERSION" ;;
    help|-h|--help) print_help ;;
    *) err "未知命令: $cmd"; print_help; exit 2 ;;
  esac
}

main "$@"
