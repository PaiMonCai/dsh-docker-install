      -u DSHD_REVERSE_MODE -u DSHD_CONFIG_FILE -u DSHD_CONTAINER_ENV_FILE \
      "DSHD_STATE_DIR=$INSTANCE_ROOT_STATE_DIR" \
      "DSHD_INSTANCE_ROOT_STATE_DIR=$INSTANCE_ROOT_STATE_DIR" \
