# Search network is independent of optional sing-box egress lifecycle.
# Legacy sidecar cleanup is intentionally ownership-checked. New installs don't
# create a separate search container or network.
search_network_name() { printf '%s-search' "$DSH_NAME"; }
search_container_name() { printf '%s-searxng' "$DSH_NAME"; }
search_owned_container() {
  [[ "$(docker_cmd inspect -f '{{index .Config.Labels "io.caicailo.dsh.component"}}' "$(search_container_name)" 2>/dev/null || true)" == "web-search" ]]
}
search_owned_network() {
  [[ "$(docker_cmd network inspect -f '{{index .Labels "io.caicailo.dsh.component"}}' "$(search_network_name)" 2>/dev/null || true)" == "web-search" ]]
}
search_remove_sidecar() {
  if docker_cmd inspect "$(search_container_name)" >/dev/null 2>&1; then
    if search_owned_container; then docker_cmd rm -f "$(search_container_name)" >/dev/null 2>&1 || true
    else warn "旧搜索容器不属于本工具，保留不动"; fi
  fi
}
search_remove_network() {
  if docker_cmd network inspect "$(search_network_name)" >/dev/null 2>&1; then
    if search_owned_network; then docker_cmd network rm "$(search_network_name)" >/dev/null 2>&1 || true
    else warn "旧搜索网络不属于本工具，保留不动"; fi
  fi
}
search_container_running() {
  container_running || return 1
  docker_cmd exec "$DSH_NAME" node -e '
    fetch("http://127.0.0.1:18788/",{signal:AbortSignal.timeout(1600)})
      .then(r=>process.exit(r.status>=200&&r.status<500?0:1))
      .catch(()=>process.exit(1))' >/dev/null 2>&1
}
# Determine the provider currently selected by the running DSH process,
# NOT the saved preference which may still be waiting for restart.
search_active_provider() {
  [[ "${DSH_SEARCH_ENABLED:-false}" == "true" ]] || { printf 'official'; return; }
  container_running || { printf 'unknown'; return; }
  local provider
  provider="$(docker_cmd exec "$DSH_NAME" node -e '
    try {
      const command = require("node:fs").readFileSync("/proc/1/cmdline", "utf8");
      if (command.includes("/dsh-web-search/cordis.searxng.patch.yml")) console.log("searxng");
      else if (command.includes("/dsh-web-search/cordis.patch.yml")) console.log("official");
      else console.log("unknown");
    } catch { console.log("unknown"); }
  ' 2>/dev/null)" || provider="unknown"
  case "$provider" in official|searxng) printf '%s' "$provider" ;; *) printf 'unknown' ;; esac
}

search_ensure_image() {
  # Validate before replacing the existing container: legacy images have no
  # embedded SearXNG and must not silently enable a broken search provider.
  docker_cmd run --rm --entrypoint /bin/sh "$DSH_IMAGE" -c \
    'test -x /opt/dsh/searxng-venv/bin/granian && test -d /opt/dsh/searxng-src' >/dev/null \
    || die "DSH 镜像没有内置 SearXNG；请先升级到包含搜索运行时的新镜像"
}

