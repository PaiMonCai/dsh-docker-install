#!/usr/bin/env bash
set -Eeuo pipefail

find_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    [[ -f "$dir/research.yaml" ]] && { printf '%s' "$dir"; return 0; }
    dir="$(dirname "$dir")"
  done
  return 1
}

hash_tree() {
  local root="$1" rel="$2" out="$3"
  : >"$out"
  [[ -d "$root/$rel" ]] || return 0
  (
    cd "$root"
    find "$rel" -type f -print0 | sort -z | xargs -0 -r sha256sum
  ) >"$out"
}

if [[ "${1:-}" == "--self-test" ]]; then
  command -v python >/dev/null
  command -v sha256sum >/dev/null
  echo "research-run self-test passed"
  exit 0
fi

label="run"
if [[ "${1:-}" == "--name" ]]; then
  [[ $# -ge 3 ]] || { echo "用法: research-run [--name LABEL] -- command [args...]" >&2; exit 2; }
  label="$2"
  shift 2
fi
[[ "${1:-}" == "--" ]] && shift
[[ $# -gt 0 ]] || { echo "缺少要执行的命令。" >&2; exit 2; }

root="$(find_root)" || { echo "未找到 research.yaml；请在 Research Project 内运行。" >&2; exit 1; }
safe_label="$(printf '%s' "$label" | tr -cs 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
[[ -n "$safe_label" ]] || safe_label="run"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
run_dir="$root/runs/$stamp-$safe_label"
mkdir -p "$run_dir/manifests" "$run_dir/environment"

printf '%q ' "$@" >"$run_dir/command.sh"
printf '\n' >>"$run_dir/command.sh"

git_commit="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
git_dirty=false
if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1   && [[ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ]]; then
  git_dirty=true
fi

python --version >"$run_dir/environment/python.txt" 2>&1 || true
uv --version >"$run_dir/environment/uv.txt" 2>&1 || true
quarto --version >"$run_dir/environment/quarto.txt" 2>&1 || true
pandoc --version | head -1 >"$run_dir/environment/pandoc.txt" 2>&1 || true
python -m pip freeze >"$run_dir/environment/pip-freeze.txt" 2>/dev/null || true

hash_tree "$root" "data/raw" "$run_dir/manifests/input-raw.sha256"
hash_tree "$root" "data/processed" "$run_dir/manifests/input-processed.sha256"

started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
python - "$run_dir/metadata.json" "$started_at" "$label" "$git_commit" "$git_dirty" <<'PY'
import json, platform, sys
path, started_at, label, commit, dirty = sys.argv[1:]
payload = {
    "schema": 1,
    "started_at": started_at,
    "label": label,
    "git_commit": commit or None,
    "git_dirty": dirty == "true",
    "platform": platform.platform(),
    "exit_code": None,
}
with open(path, "w", encoding="utf-8") as f:
    json.dump(payload, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY

set +e
(
  cd "$root"
  "$@"
) > >(tee "$run_dir/stdout.log") 2> >(tee "$run_dir/stderr.log" >&2)
status=$?
set -e

hash_tree "$root" "results" "$run_dir/manifests/output-results.sha256"
hash_tree "$root" "paper" "$run_dir/manifests/output-paper.sha256"

finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
python - "$run_dir/metadata.json" "$finished_at" "$status" <<'PY'
import json, sys
path, finished_at, status = sys.argv[1:]
with open(path, encoding="utf-8") as f:
    payload = json.load(f)
payload["finished_at"] = finished_at
payload["exit_code"] = int(status)
with open(path, "w", encoding="utf-8") as f:
    json.dump(payload, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY

ln -sfn "$(basename "$run_dir")" "$root/runs/latest"
printf '\nResearch run recorded: %s\n' "$run_dir"
exit "$status"
