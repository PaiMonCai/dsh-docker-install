#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

from dsh_research.errors import ResearchError
from dsh_research.project import ResearchProject
from dsh_research.runs import RUN_MANIFEST_SCHEMA, record_run


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="research-run",
        description="执行命令并记录可复现的 Research Run Manifest v2。",
    )
    parser.add_argument("--name", default="run", help="run label")
    parser.add_argument("--input-dataset", action="append", default=[], help="精确记录输入 dataset，可重复")
    parser.add_argument("--input-file", action="append", default=[], help="精确记录输入文件，可重复")
    parser.add_argument("--output-file", action="append", default=[], help="精确记录输出文件，可重复")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    return parser


def self_test() -> int:
    import json
    import tempfile

    with tempfile.TemporaryDirectory() as td:
        root = Path(td).resolve()
        (root / "research.yaml").write_text(
            "schema: 2\nproject:\n  slug: smoke\n  title: Smoke\n  template: default\n  status: active\n",
            encoding="utf-8",
        )
        project = ResearchProject(root)
        result = record_run(
            project,
            label="smoke",
            command=[sys.executable, "-c", "from pathlib import Path; Path('out.txt').write_text('ok')"],
            output_files=["out.txt"],
        )
        payload = json.loads(result.manifest_path.read_text(encoding="utf-8"))
        assert payload["schema"] == 2
        assert payload["success"] is True
        assert payload["outputs"]["files"][0]["status"] == "current"
        assert (result.run_dir / "command.sh").is_file()
        assert (result.run_dir / "stdout.log").is_file()
    print("research-run self-test passed")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.self_test:
        return self_test()

    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        print("缺少要执行的命令。", file=sys.stderr)
        return 2

    try:
        project = ResearchProject.discover()
        result = record_run(
            project,
            label=args.name,
            command=command,
            input_datasets=args.input_dataset,
            input_files=args.input_file,
            output_files=args.output_file,
        )
        print(f"\nResearch run recorded: {result.run_dir}")
        print(f"Run manifest schema: {RUN_MANIFEST_SCHEMA}")
        return result.exit_code
    except ResearchError as exc:
        print(f"[error] {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"[error] {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
