# 复制为 .env 后使用（docker compose 会自动读取）。
# 也可以不用 .env，直接 export 同名环境变量。

# DeepSeek API Key。官方 API 和自定义 Base URL 都使用这个变量。
DEEPSEEK_API_KEY=

# 可选：自定义 DeepSeek 兼容 API Base URL。
# 留空/不传时使用 DeepSeek 官方默认地址。
# 例：DEEPSEEK_BASE_URL=https://api.example.com
DEEPSEEK_BASE_URL=

# 通过域名/局域网访问时，把对外 authority 写在这里（逗号分隔）。
# 只从宿主机 http://127.0.0.1:3080 访问时留空即可。
# 例：DSH_TRUSTED_HOSTS=dsh.example.com,dsh.internal:3080
DSH_TRUSTED_HOSTS=

# 自定义模型推理等级编辑器。默认启用；设为 false 会通过 dsh plugin 从 web profile 移除。
DSH_REASONING_EDITOR=true

# 挂载到容器 /workspace 的宿主机目录（默认 ./workspace）。
DSH_WORKSPACE=./workspace

# Chromium/Playwright 共享内存。Docker 默认仅 64M，推荐 1g。
DSH_SHM_SIZE=1g

# 容器时区，默认中国标准时间。
DSH_TIMEZONE=Asia/Shanghai

# npm cache 放在 Landlock 默认可写的 /tmp，避免 npm install 因 /root/.npm 被拒。
DSH_NPM_CACHE=/tmp/npm-cache

# 可选：容器内监听端口（同时要改 docker-compose.yml 的 ports 映射）。
# DSH_PORT=3080

# 可选：文件沙箱不可用时（容器内核不给 bubblewrap/Landlock）的降级开关。
# DSH_PERMISSION_MODE=danger-full-access

# 可选：bind host，默认 0.0.0.0；改成 127.0.0.1 则只能在容器内访问。
# DSH_BIND_HOST=0.0.0.0
