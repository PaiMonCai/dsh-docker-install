#!/usr/bin/env python3
"""Reverse Edition offline task queue: explicit worker, durable JSON, allowlisted tools."""
import argparse
from datetime import datetime, timezone
import fcntl
import hashlib
import json
import os
import signal
from pathlib import Path
import subprocess
import sys
import tempfile
import uuid

ROOT = Path(os.environ.get("DSH_REVERSE_WORKSPACE_ROOT", "/workspace")).resolve()
STORE = ROOT / ".reverse-tasks"
TOOLS = {
    "triage": ("reverse-triage", 180, 1, 2),
    "js-triage": ("reverse-js-triage", 90, 1, 2),
    "ghidra": ("reverse-ghidra", 930, 1, 2),
    "diff": ("reverse-diff", 60, 2, 2),
    "verify": ("reverse-workspace", 90, 1, 1),
}
CASES = ROOT / ".reverse-cases"
MAX_TASKS = 300
MAX_LOG = 10000
MAX_EVENTS = 24


def trace(task, action):
    """Keep a compact bounded lifecycle trace in the task's authoritative JSON.
    No arguments, sample paths, tool output, or credentials are copied here.
    Legacy task records may start recording at the first new transition.
    """
    events = task.setdefault("events", [])
    if not isinstance(events, list):
        raise ValueError("invalid task event history")
    event = {"at": timestamp(), "action": action, "state": task["state"]}
    task["events"] = events[-(MAX_EVENTS - 1):] + [event]


def peek():
    """Authoritative queue ordering, shared by CLI and Web preflight.
    Worker still rechecks expected-id while holding its exclusive lock.
    """
    pending = []
    staged = interrupted = 0
    for entry in all_tasks():
        try:
            item = read_task(entry.stem)
        except (OSError, ValueError, json.JSONDecodeError):
            continue
        if item.get("state") == "queued":
            pending.append(item)
        elif item.get("state") == "staging":
            staged += 1
        elif item.get("state") == "interrupted":
            interrupted += 1
    ordered = sorted(pending, key=lambda t: (t["created_at"], t["id"]))
    head = ordered[0] if ordered else None
    return {
        "schema": "dsh-reverse-queue-status/v1",
        "head_id": head["id"] if head else None,
        "head_kind": head["kind"] if head else None,
        "queued_count": len(ordered),
        "staged_count": staged,
        "interrupted_count": interrupted,
    }


def timestamp():
    return datetime.now(timezone.utc).isoformat()

def atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp = tempfile.mkstemp(prefix=".task-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as file:
            os.fchmod(file.fileno(), 0o600)
            json.dump(value, file, ensure_ascii=False, indent=2)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

def safe_path(value):
    source = Path(value).expanduser()
    if source.is_symlink():
        raise ValueError("symlinks are not allowed")
    try:
        path = source.resolve(strict=True)
    except FileNotFoundError:
        raise ValueError("task input no longer exists") from None
    if not path.is_relative_to(ROOT) or not path.is_file() and not path.is_dir():
        raise ValueError("task input must be a workspace file or directory")
    return str(path)

def task_path(task_id):
    try:
        if str(uuid.UUID(task_id)) != task_id:
            raise ValueError()
    except (ValueError, AttributeError):
        raise ValueError("invalid task identifier")
    return STORE / (task_id + ".json")

def read_task(task_id):
    path = task_path(task_id)
    if STORE.is_symlink() or path.is_symlink() or not path.is_file() or path.stat().st_size > 30000:
        raise ValueError("task not found or unsafe")
    data = json.loads(path.read_text("utf-8"))
    if data.get("schema") != "dsh-reverse-task/v1" or data.get("id") != task_id:
        raise ValueError("invalid task record")
    return data

def all_tasks():
    if not STORE.exists():
        return []
    return sorted(
        (entry for entry in STORE.iterdir() if entry.name.endswith(".json") and not entry.is_symlink()),
        key=lambda entry: entry.name
    )[:MAX_TASKS + 1]

def case_reference(case_id, kind, inputs):
    if not case_id:
        return None
    try:
        if str(uuid.UUID(case_id)) != case_id:
            raise ValueError()
    except (ValueError, TypeError, AttributeError):
        raise ValueError("invalid case identifier") from None
    path = CASES / (case_id + ".json")
    if CASES.is_symlink() or path.is_symlink() or not path.is_file() or path.stat().st_size > 256 * 1024:
        raise ValueError("case reference missing or unsafe")
    case = json.loads(path.read_text(encoding="utf-8"))
    if case.get("schema") != "dsh-reverse-case/v1" or case.get("id") != case_id:
        raise ValueError("case reference is invalid")
    if kind in ("triage", "ghidra", "js-triage"):
        target = case.get("target")
        if not isinstance(target, dict) or not isinstance(target.get("path"), str):
            raise ValueError("case target missing")
        if str(Path(inputs[0]).relative_to(ROOT)) != target["path"]:
            raise ValueError("task input does not match case target")
    return case_id


def enqueue(kind, inputs, case_id=None, stage=False):
    if STORE.is_symlink():
        raise ValueError("unsafe task store")
    if kind not in TOOLS:
        raise ValueError("unsupported task kind")
    tool, timeout, low, high = TOOLS[kind]
    if not low <= len(inputs) <= high:
        raise ValueError("invalid task input count")
    arguments = [safe_path(x) for x in inputs]
    bound_case = case_reference(case_id, kind, arguments)
    if len(all_tasks()) >= MAX_TASKS:
        raise ValueError("task queue has reached capacity")
    task_id = str(uuid.uuid4())
    record = {"schema": "dsh-reverse-task/v1", "id": task_id, "kind": kind,
              "inputs": arguments, "state": "staging" if stage else "queued", "attempts": 0,
              "created_at": timestamp(), "updated_at": timestamp(),
              "result": None, "last_error": None}
    if bound_case:
        record["case_id"] = bound_case
    trace(record, "staged" if stage else "enqueued")
    atomic(task_path(task_id), record)
    return record


def publish(task_id):
    """Commit an explicitly linked staging task to the global execution queue."""
    task = read_task(task_id)
    if task["state"] != "staging":
        raise ValueError("only staged tasks can be published")
    if task.get("kind") not in TOOLS:
        raise ValueError("unsupported staged task kind")
    _, _, minimum, maximum = TOOLS[task["kind"]]
    inputs = task.get("inputs")
    if not isinstance(inputs, list) or not minimum <= len(inputs) <= maximum:
        raise ValueError("invalid staged task inputs")
    paths = [safe_path(value) for value in inputs]
    if task.get("case_id"):
        case_reference(task["case_id"], task["kind"], paths)
    task["state"] = "queued"
    task["updated_at"] = timestamp()
    trace(task, "published")
    atomic(task_path(task_id), task)
    return task


def discard(task_id):
    """Explicitly abandon a staged, non-executable task whose project link failed."""
    task = read_task(task_id)
    if task["state"] != "staging":
        raise ValueError("only staged tasks can be discarded")
    task_path(task_id).unlink()
    return {"id": task_id, "discarded": True}


def invocation(task):
    kind, files = task["kind"], task["inputs"]
    if kind not in TOOLS:
        raise ValueError("unknown task kind")
    tool, timeout, low, high = TOOLS[kind]
    if not low <= len(files) <= high:
        raise ValueError("invalid stored task input count")
    paths = [safe_path(p) for p in files]
    # Only these fixed subcommands exist. No shell, user-defined options or executable paths.
    if kind == "triage":
        cmd = [tool, paths[0]]
    elif kind == "js-triage":
        cmd = [tool, paths[0]]
    elif kind == "ghidra":
        dest = ROOT / "reverse-analysis" / ("task-" + task["id"])
        dest.mkdir(parents=True, exist_ok=True, mode=0o700)
        cmd = [tool, paths[0], "--output", str(dest), "--timeout", "300", "--max-functions", "40"]
    elif kind == "diff":
        cmd = [tool] + paths
    else:
        cmd = [tool, "verify", paths[0]]
    return cmd, timeout

def worker_once(expected_id=None):
    STORE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(STORE / ".worker.lock", "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        pending = []
        for file in all_tasks():
            try:
                task = read_task(file.stem)
                if task["state"] == "queued":
                    pending.append(task)
            except (OSError, ValueError, json.JSONDecodeError):
                continue
        if not pending:
            return {"status": "idle"}
        task = sorted(pending, key=lambda t: (t["created_at"], t["id"]))[0]
        if expected_id is not None and task["id"] != expected_id:
            raise ValueError("expected task is not at the head of the queue")
        task["state"] = "running"
        task["attempts"] += 1
        task["updated_at"] = timestamp()
        trace(task, "started")
        atomic(task_path(task["id"]), task)
        try:
            cmd, timeout = invocation(task)
            process = subprocess.Popen(cmd, cwd=ROOT, shell=False,
                                       stdin=subprocess.DEVNULL,
                                       stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       start_new_session=True)
            try:
                stdout, stderr = process.communicate(timeout=timeout)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                try:
                    process.communicate(timeout=5)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    process.communicate()
                raise
            out = stdout.decode("utf-8", errors="replace")[-MAX_LOG:]
            err = stderr.decode("utf-8", errors="replace")[-MAX_LOG:]
            task["result"] = {"exit_code": process.returncode,
                              "stdout": out, "stderr": err}
            task["state"] = "succeeded" if process.returncode == 0 else "failed"
            task["last_error"] = None if process.returncode == 0 else "tool exited unsuccessfully"
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            task["state"] = "failed"
            task["last_error"] = type(error).__name__
        task["updated_at"] = timestamp()
        trace(task, "completed" if task["state"] == "succeeded" else "failed")
        atomic(task_path(task["id"]), task)
        return task

def recover():
    """Recover crashed workers conservatively; nothing executes until run-once."""
    STORE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(STORE / ".worker.lock", "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        recovered = []
        for file in all_tasks():
            try:
                task = read_task(file.stem)
                if task["state"] != "running":
                    continue
                task["state"] = "interrupted"
                task["last_error"] = "worker interrupted; operator must explicitly retry"
                task["updated_at"] = timestamp()
                trace(task, "interrupted")
                atomic(task_path(task["id"]), task)
                recovered.append(task["id"])
            except (OSError, ValueError, json.JSONDecodeError):
                continue
        return {"interrupted": recovered}

def retry(task_id):
    record = read_task(task_id)
    if record["state"] not in ("failed", "interrupted"):
        raise ValueError("only failed or interrupted tasks can be retried")
    if record["attempts"] >= 3:
        raise ValueError("retry limit reached")
    record["state"] = "queued"
    record["updated_at"] = timestamp()
    record["last_error"] = None
    trace(record, "retried")
    atomic(task_path(task_id), record)
    return record

def main():
    p = argparse.ArgumentParser(description="Durable, explicit-worker Reverse analysis tasks")
    sub = p.add_subparsers(dest="mode", required=True)
    q = sub.add_parser("enqueue")
    q.add_argument("kind", choices=sorted(TOOLS))
    q.add_argument("inputs", nargs="+")
    q.add_argument("--case-id", help="Associate task with a persisted Reverse case (metadata only)")
    q.add_argument("--stage", action="store_true", help="Stage without queueing; requires explicit publish")
    for name in ("show", "retry", "publish", "discard"):
        s = sub.add_parser(name)
        s.add_argument("id")
    sub.add_parser("list")
    sub.add_parser("peek")
    once = sub.add_parser("run-once")
    once.add_argument("--expected-id")
    sub.add_parser("recover")
    args = p.parse_args()
    try:
        if args.mode == "enqueue":
            result = enqueue(args.kind, args.inputs, args.case_id, args.stage)
        elif args.mode == "show":
            result = read_task(args.id)
        elif args.mode == "retry":
            result = retry(args.id)
        elif args.mode == "publish":
            result = publish(args.id)
        elif args.mode == "discard":
            result = discard(args.id)
        elif args.mode == "list":
            result = [read_task(x.stem) for x in all_tasks()]
        elif args.mode == "peek":
            result = peek()
        elif args.mode == "recover":
            result = recover()
        else:
            result = worker_once(args.expected_id)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (OSError, ValueError, BlockingIOError, json.JSONDecodeError) as error:
        print("reverse-task: " + str(error), file=sys.stderr)
        return 2

if __name__ == "__main__":
    sys.exit(main())
