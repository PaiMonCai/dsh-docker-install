#!/usr/bin/env python3
"""Read-only capability closure for Reverse Edition; never executes a target or installs software."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import shutil
import sys

SCHEMA = "dsh-reverse-capabilities/v1"
BINARIES = (
    "python3", "file", "reverse-triage", "reverse-js-triage", "reverse-ghidra",
    "reverse-workspace", "reverse-diff", "reverse-task", "rea", "jadx", "apktool",
    "gdb", "gdb-multiarch", "readelf", "node", "frida", "frida-ps",
    "tshark", "binwalk", "wasm2wat", "capa",
)
MODULES = ("lief", "frida", "capstone")
# Dependencies are physical atoms, not broad heuristics such as "has Python".
ROUTES = {
    "static-triage": {
        "required": ("reverse-triage",),
        "optional": ("file", "capa", "py:lief"),
    },
    "native-static": {
        "required": ("reverse-ghidra", "ghidra-headless", "readelf"),
        "optional": ("gdb", "py:capstone"),
    },
    "windows-pe-static": {
        "required": ("reverse-triage", "reverse-ghidra", "ghidra-headless"),
        "optional": ("gdb-multiarch",),
    },
    "android-static": {
        "required": ("jadx", "apktool"),
        "optional": ("reverse-triage",),
    },
    "electron-js-static": {
        "required": ("reverse-js-triage", "node"),
        "optional": ("reverse-triage",),
    },
    "network-offline": {
        "required": ("python3",),
        "optional": ("tshark",),
    },
    "firmware-static": {
        "required": ("reverse-triage",),
        "optional": ("binwalk", "reverse-ghidra"),
    },
    "wasm-static": {
        "required": ("reverse-triage",),
        "optional": ("wasm2wat",),
    },
    "runtime-frida": {
        "required": ("frida", "frida-ps", "py:frida"),
        "optional": (),
        "external": ("Authorized reachable target and compatible device-side instrumentation",),
    },
}


def probe():
    """Presence only: do not execute --version on unknown binaries or import modules."""
    atoms = {}
    for name in BINARIES:
        found = shutil.which(name)
        atoms[name] = {"state": "found" if found else "missing", "path": found}
    ghidra = os.environ.get("GHIDRA_INSTALL_DIR", "/opt/ghidra")
    candidate = Path(ghidra) / "support" / "analyzeHeadless"
    found = str(candidate) if candidate.is_file() and os.access(candidate, os.X_OK) else None
    atoms["ghidra-headless"] = {"state": "found" if found else "missing", "path": found}
    for name in MODULES:
        # find_spec locates packages without executing import side effects.
        try:
            spec = importlib.util.find_spec(name)
        except (ImportError, ValueError, AttributeError):
            spec = None
        atoms["py:" + name] = {"state": "found" if spec is not None else "missing",
                                "path": None}
    return atoms


def evaluate(atoms):
    results = {}
    for name, spec in ROUTES.items():
        required = list(spec["required"])
        optional = list(spec["optional"])
        missing = [atom for atom in required if atoms.get(atom, {}).get("state") != "found"]
        not_optional = [atom for atom in optional if atoms.get(atom, {}).get("state") != "found"]
        external = list(spec.get("external", ()))
        # External environment is deliberately not inferred from host-side binaries.
        state = ("blocked" if missing else
                 "partial" if not_optional or external else "available")
        results[name] = {
            "state": state, "required": required, "optional": optional,
            "missing_required": missing, "missing_optional": not_optional,
            "external_unverified": external,
        }
    return results


def main(argv=None):
    parser = argparse.ArgumentParser(description="Inspect Reverse Edition tool presence without executing samples")
    parser.add_argument("--json", action="store_true", help="Machine-readable capability results")
    parser.add_argument("--route", choices=sorted(ROUTES), help="Show one route")
    args = parser.parse_args(argv)
    atoms = probe()
    routes = evaluate(atoms)
    if args.route:
        routes = {args.route: routes[args.route]}
    report = {
        "schema": SCHEMA, "basis": "presence-only",
        "warning": "Presence is not proof of runtime access, ABI support or a working tool operation.",
        "capabilities": routes, "atoms": atoms,
    }
    if args.json:
        print(json.dumps(report, ensure_ascii=False, sort_keys=True))
    else:
        for name, info in routes.items():
            missing = ",".join(info["missing_required"] + info["missing_optional"])
            print(name + ": " + info["state"] + ((" (missing: " + missing + ")") if missing else ""))
        print(report["warning"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
